<template name="Console">
	<head>
		<title>Console</title>
		<link type="text/rcss" href="../../BaseStyles.rcss" />
		<link type="text/template" href="../Base/BasePopup.rml" />
		<link type="text/rcss" href="Console.rcss" />
		<script lang="text/lua">
			-- Default each freshly loaded console document to the original static console.
			gConsoleFloaty = false
			gConsoleStyleStartupDone = false
			gConsoleActiveOwner = 'static'
			gConsoleStaticFinalized = false

			function ConsoleScrollToBottom(document, element)
				if not document then return '' end
				-- This belongs to the original static console only.
				-- When floaty mode is active, the static list/anchor can still update while hidden,
				-- so do not let it scroll the floaty log.
				if gConsoleFloaty == true then return '' end
				local lc = document:GetElementById('log-content')
				if lc and lc.scroll_height and lc.client_height then
					lc.scroll_top = lc.scroll_height + lc.client_height + 1000000
				end
				return ''
			end

			function ConsoleScrollToBottomForLines(document, element, line_count)
				return ConsoleScrollToBottom(document, element)
			end

			function MaybeCloseChatOnEnter(event, document)
				if not document then return '' end
				local params = event and event.parameters
				if not params then return '' end

				if params['key_identifier'] ~= 72 then
					gEnterArmed = true
					return ''
				end

				local hp = document:GetElementById('msg-hint-panel')
				local isEmpty = hp and not hp:IsClassSet('hidden')
				if not isEmpty then
					gEnterArmed = true
					return ''
				end

				if gEnterArmed then
					OnEvent(event, 'on-chat')
					gEnterArmed = false
				else
					gEnterArmed = true
				end

				return ''
			end

			function ResetConsoleEnterArm()
				gEnterArmed = false
				return ''
			end

			function ConsoleHandlePress(document)
				if not document then return '' end
				if gConsoleFloaty ~= true then ConsoleCenterStaticFrame(document) end
				local chat = document:GetElementById('chat_window')
				if not chat then return '' end
				chat.style.max_height = '500dp'
				gPullStartHeight = chat.offset_height or 250
				return ''
			end

			function ConsoleStaticOnShow(document, element)
				if gConsoleFloaty ~= true then
					ConsoleActivateStaticIds(document)
					ConsoleResetStaticPosition(document)
				end
				ConsoleScrollToBottom(document, element)
				return ''
			end

			function ConsoleToggleChatHeight(event, document)
				if not document then return '' end
				local chat = document:GetElementById('chat_window')
				if not chat then return '' end

				local currentHeight = chat.offset_height or 250
				if gPullStartHeight and math.abs(currentHeight - gPullStartHeight) > 8 then
					gPullStartHeight = nil
					ConsoleCenterStaticFrame(document)
					ConsoleScrollToBottom(document, chat)
					return ''
				end

				if currentHeight >= 530 then
					chat.style.height = '250dp'
				else
					chat.style.height = '500dp'
				end

				ConsoleCenterStaticFrame(document)
				ConsoleScrollToBottom(document, chat)
				gPullStartHeight = nil
				if event then event:StopPropagation() end
				return ''
			end


			-- Console style toggle bridge only: static and floaty stay isolated.
			-- The active console owns the original ids (chat_window/input-text/etc.) so the client focus/send logic keeps working.
			-- The inactive console gets suffixed ids and is display:none.
			function ConsoleSetId(element, new_id)
				if not element then return '' end
				pcall(function() element:SetAttribute('id', new_id) end)
				pcall(function() element.id = new_id end)
				return ''
			end

			function ConsoleSetAttr(element, name, value)
				if not element then return '' end
				pcall(function() element:SetAttribute(name, value) end)
				return ''
			end

			function ConsoleById(document, id_a, id_b)
				if not document then return nil end
				local e = nil
				if id_a then e = document:GetElementById(id_a) end
				if e then return e end
				if id_b then return document:GetElementById(id_b) end
				return nil
			end

			function ConsoleIsStaticRoot(element)
				return element and element.IsClassSet and element:IsClassSet('console_static_panel')
			end

			function ConsoleIsFloatyRoot(element)
				return element and element.IsClassSet and element:IsClassSet('console_floaty_panel')
			end

			function ConsoleGetStaticRoot(document)
				local e = ConsoleById(document, 'chat_window_static', nil)
				if e then return e end
				e = ConsoleById(document, 'chat_window', nil)
				if ConsoleIsStaticRoot(e) then return e end
				return nil
			end

			function ConsoleGetFloatyRoot(document)
				local e = ConsoleById(document, 'chat_window_floaty', nil)
				if e then return e end
				e = ConsoleById(document, 'chat_window', nil)
				if ConsoleIsFloatyRoot(e) then return e end
				return nil
			end

			function ConsoleRename(document, from_id, to_id)
				local e = ConsoleById(document, from_id, nil)
				if e then ConsoleSetId(e, to_id) end
				return ''
			end

			function ConsoleSetFilterFors(document, suffix)
				local ids = {'all', 'world', 'private', 'system', 'custom'}
				for i, name in ipairs(ids) do
					local label = ConsoleById(document, 'filter_label_' .. name .. suffix, nil)
					if label then ConsoleSetAttr(label, 'for', 'filter_' .. name .. suffix) end
				end
				return ''
			end

			function ConsoleDeactivateStaticIds(document)
				-- While floaty is active, move the static root away from the engine's live chat_window id.
				-- Static is reset to its real top/center position every time it becomes active again.
				if gConsoleActiveOwner ~= 'static' then return '' end
				local root = ConsoleGetStaticRoot(document)
				if not root then return '' end
				ConsoleSetId(root, 'chat_window_static')
				ConsoleRename(document, 'filter', 'filter_static')
				ConsoleRename(document, 'filter_all', 'filter_all_static')
				ConsoleRename(document, 'filter_world', 'filter_world_static')
				ConsoleRename(document, 'filter_private', 'filter_private_static')
				ConsoleRename(document, 'filter_system', 'filter_system_static')
				ConsoleRename(document, 'filter_custom', 'filter_custom_static')
				ConsoleRename(document, 'filter_label_all', 'filter_label_all_static')
				ConsoleRename(document, 'filter_label_world', 'filter_label_world_static')
				ConsoleRename(document, 'filter_label_private', 'filter_label_private_static')
				ConsoleRename(document, 'filter_label_system', 'filter_label_system_static')
				ConsoleRename(document, 'filter_label_custom', 'filter_label_custom_static')
				ConsoleRename(document, 'chat_image', 'chat_image_static')
				ConsoleRename(document, 'custom-settings-popup', 'custom-settings-popup_static')
				ConsoleRename(document, 'custom-settings', 'custom-settings_static')
				ConsoleRename(document, 'preview-content', 'preview-content_static')
				ConsoleRename(document, 'preview-text', 'preview-text_static')
				ConsoleRename(document, 'log-top', 'log-top_static')
				ConsoleRename(document, 'log-content', 'log-content_static')
				ConsoleRename(document, 'log-spacer', 'log-spacer_static')
				ConsoleRename(document, 'log-lines', 'log-lines_static')
				ConsoleRename(document, 'text-line', 'text-line_static')
				ConsoleRename(document, 'image', 'image_static')
				ConsoleRename(document, 'text', 'text_static')
				ConsoleRename(document, 'scroll-anchor', 'scroll-anchor_static')
				ConsoleRename(document, 'input-content', 'input-content_static')
				ConsoleRename(document, 'input-text', 'input-text_static')
				ConsoleRename(document, 'input-info', 'input-info_static')
				ConsoleRename(document, 'msg-hint-panel', 'msg-hint-panel_static')
				ConsoleRename(document, 'message-hint-text', 'message-hint-text_static')
				ConsoleRename(document, 'pull_down_button', 'pull_down_button_static')
				ConsoleRename(document, 'pull_down_icon', 'pull_down_icon_static')
				ConsoleSetFilterFors(document, '_static')
				local pull = ConsoleById(document, 'pull_down_button_static', nil)
				ConsoleSetAttr(pull, 'size_target', 'chat_window')
				return ''
			end

			function ConsoleActivateStaticIds(document)
				if gConsoleActiveOwner == 'floaty' then ConsoleDeactivateFloatyIds(document) end
				local root = ConsoleGetStaticRoot(document)
				if not root then return '' end
				ConsoleSetId(root, 'chat_window')
				ConsoleRename(document, 'filter_static', 'filter')
				ConsoleRename(document, 'filter_all_static', 'filter_all')
				ConsoleRename(document, 'filter_world_static', 'filter_world')
				ConsoleRename(document, 'filter_private_static', 'filter_private')
				ConsoleRename(document, 'filter_system_static', 'filter_system')
				ConsoleRename(document, 'filter_custom_static', 'filter_custom')
				ConsoleRename(document, 'filter_label_all_static', 'filter_label_all')
				ConsoleRename(document, 'filter_label_world_static', 'filter_label_world')
				ConsoleRename(document, 'filter_label_private_static', 'filter_label_private')
				ConsoleRename(document, 'filter_label_system_static', 'filter_label_system')
				ConsoleRename(document, 'filter_label_custom_static', 'filter_label_custom')
				ConsoleRename(document, 'chat_image_static', 'chat_image')
				ConsoleRename(document, 'custom-settings-popup_static', 'custom-settings-popup')
				ConsoleRename(document, 'custom-settings_static', 'custom-settings')
				ConsoleRename(document, 'preview-content_static', 'preview-content')
				ConsoleRename(document, 'preview-text_static', 'preview-text')
				ConsoleRename(document, 'log-top_static', 'log-top')
				ConsoleRename(document, 'log-content_static', 'log-content')
				ConsoleRename(document, 'log-spacer_static', 'log-spacer')
				ConsoleRename(document, 'log-lines_static', 'log-lines')
				ConsoleRename(document, 'text-line_static', 'text-line')
				ConsoleRename(document, 'image_static', 'image')
				ConsoleRename(document, 'text_static', 'text')
				ConsoleRename(document, 'scroll-anchor_static', 'scroll-anchor')
				ConsoleRename(document, 'input-content_static', 'input-content')
				ConsoleRename(document, 'input-text_static', 'input-text')
				ConsoleRename(document, 'input-info_static', 'input-info')
				ConsoleRename(document, 'msg-hint-panel_static', 'msg-hint-panel')
				ConsoleRename(document, 'message-hint-text_static', 'message-hint-text')
				ConsoleRename(document, 'pull_down_button_static', 'pull_down_button')
				ConsoleRename(document, 'pull_down_icon_static', 'pull_down_icon')
				ConsoleSetFilterFors(document, '')
				local pull = ConsoleById(document, 'pull_down_button', nil)
				ConsoleSetAttr(pull, 'size_target', 'chat_window')
				gConsoleActiveOwner = 'static'
				return ''
			end

			function ConsoleDeactivateFloatyIds(document)
				if gConsoleActiveOwner ~= 'floaty' then return '' end
				local root = ConsoleGetFloatyRoot(document)
				if not root then return '' end
				ConsoleSetId(root, 'chat_window_floaty')
				ConsoleRename(document, 'preview-content', 'preview-content_floaty')
				ConsoleRename(document, 'preview-text', 'preview-text_floaty')
				ConsoleRename(document, 'message-hint-text', 'message-hint-text_floaty')
				ConsoleRename(document, 'filter', 'filter_floaty')
				ConsoleRename(document, 'filter_all', 'filter_all_floaty')
				ConsoleRename(document, 'filter_world', 'filter_world_floaty')
				ConsoleRename(document, 'filter_private', 'filter_private_floaty')
				ConsoleRename(document, 'filter_system', 'filter_system_floaty')
				ConsoleRename(document, 'filter_custom', 'filter_custom_floaty')
				ConsoleRename(document, 'filter_label_all', 'filter_label_all_floaty')
				ConsoleRename(document, 'filter_label_world', 'filter_label_world_floaty')
				ConsoleRename(document, 'filter_label_private', 'filter_label_private_floaty')
				ConsoleRename(document, 'filter_label_system', 'filter_label_system_floaty')
				ConsoleRename(document, 'filter_label_custom', 'filter_label_custom_floaty')
				ConsoleRename(document, 'chat_image', 'chat_image_floaty')
				ConsoleRename(document, 'custom-settings-popup', 'custom-settings-popup_floaty')
				ConsoleRename(document, 'custom-settings', 'custom-settings_floaty')
				ConsoleRename(document, 'input-content', 'input-content_floaty')
				ConsoleRename(document, 'input-text', 'input-text_floaty')
				ConsoleRename(document, 'input-info', 'input-info_floaty')
				ConsoleRename(document, 'move_handle', 'move_handle_floaty')
				ConsoleRename(document, 'log-top', 'log-top_floaty')
				ConsoleRename(document, 'log-content', 'log-content_floaty')
				ConsoleRename(document, 'text-line', 'text-line_floaty')
				ConsoleRename(document, 'image', 'image_floaty')
				ConsoleRename(document, 'text', 'text_floaty')
				ConsoleRename(document, 'resize_bl', 'resize_bl_floaty')
				ConsoleSetFilterFors(document, '_floaty')
				local move = ConsoleById(document, 'move_handle_floaty', nil)
				ConsoleSetAttr(move, 'move_target', 'chat_window_floaty')
				local resize = ConsoleById(document, 'resize_bl_floaty', nil)
				ConsoleSetAttr(resize, 'size_target', 'chat_window_floaty')
				return ''
			end

			function ConsoleActivateFloatyIds(document)
				if gConsoleActiveOwner == 'static' then ConsoleDeactivateStaticIds(document) end
				local root = ConsoleGetFloatyRoot(document)
				if not root then return '' end
				ConsoleSetId(root, 'chat_window')
				ConsoleRename(document, 'preview-content_floaty', 'preview-content')
				ConsoleRename(document, 'preview-text_floaty', 'preview-text')
				ConsoleRename(document, 'message-hint-text_floaty', 'message-hint-text')
				ConsoleRename(document, 'filter_floaty', 'filter')
				ConsoleRename(document, 'filter_all_floaty', 'filter_all')
				ConsoleRename(document, 'filter_world_floaty', 'filter_world')
				ConsoleRename(document, 'filter_private_floaty', 'filter_private')
				ConsoleRename(document, 'filter_system_floaty', 'filter_system')
				ConsoleRename(document, 'filter_custom_floaty', 'filter_custom')
				ConsoleRename(document, 'filter_label_all_floaty', 'filter_label_all')
				ConsoleRename(document, 'filter_label_world_floaty', 'filter_label_world')
				ConsoleRename(document, 'filter_label_private_floaty', 'filter_label_private')
				ConsoleRename(document, 'filter_label_system_floaty', 'filter_label_system')
				ConsoleRename(document, 'filter_label_custom_floaty', 'filter_label_custom')
				ConsoleRename(document, 'chat_image_floaty', 'chat_image')
				ConsoleRename(document, 'custom-settings-popup_floaty', 'custom-settings-popup')
				ConsoleRename(document, 'custom-settings_floaty', 'custom-settings')
				ConsoleRename(document, 'input-content_floaty', 'input-content')
				ConsoleRename(document, 'input-text_floaty', 'input-text')
				ConsoleRename(document, 'input-info_floaty', 'input-info')
				ConsoleRename(document, 'move_handle_floaty', 'move_handle')
				ConsoleRename(document, 'log-top_floaty', 'log-top')
				ConsoleRename(document, 'log-content_floaty', 'log-content')
				ConsoleRename(document, 'text-line_floaty', 'text-line')
				ConsoleRename(document, 'image_floaty', 'image')
				ConsoleRename(document, 'text_floaty', 'text')
				ConsoleRename(document, 'resize_bl_floaty', 'resize_bl')
				ConsoleSetFilterFors(document, '')
				local move = ConsoleById(document, 'move_handle', nil)
				ConsoleSetAttr(move, 'move_target', 'chat_window')
				local resize = ConsoleById(document, 'resize_bl', nil)
				ConsoleSetAttr(resize, 'size_target', 'chat_window')
				gConsoleActiveOwner = 'floaty'
				return ''
			end

			function ConsoleStartupStatic(document)
				if not document then return '' end
				-- Run once for this document/template load: first world enter should always be static.
				if gConsoleStyleStartupDone == true then return '' end
				local staticChat = ConsoleGetStaticRoot(document)
				if not staticChat then return '' end
				local floatyChat = ConsoleGetFloatyRoot(document)
				gConsoleStyleStartupDone = true
				gConsoleStaticFinalized = false
				gConsoleFloaty = false
				gConsoleActiveOwner = 'static'
				ConsoleActivateStaticIds(document)
				ConsoleResetStaticPosition(document)
				staticChat = ConsoleGetStaticRoot(document)
				floatyChat = ConsoleGetFloatyRoot(document)
				if staticChat then
					ConsoleSetId(staticChat, 'chat_window')
					staticChat:SetClass('console_style_initialized', true)
					staticChat:SetClass('console_style_hidden', false)
				end
				if floatyChat then
					ConsoleSetId(floatyChat, 'chat_window_floaty')
					floatyChat:SetClass('console_style_hidden', true)
				end
				ConsoleSetToggleButtons(document)
				return ''
			end

			function ConsoleStartupAndApply(document)
				ConsoleStartupStatic(document)
				ConsoleApplyStyleBridge(document)
				return ''
			end

			function ConsoleStartupFinalizeStatic(document)
				if not document then return '' end
				if gConsoleFloaty == true then return '' end
				if gConsoleStaticFinalized == true then return '' end
				gConsoleStaticFinalized = true
				ConsoleActivateStaticIds(document)
				ConsoleResetStaticPosition(document)
				return ''
			end

			function ConsoleEnsureStyleState(document)
				if not document then return '' end
				local staticChat = ConsoleGetStaticRoot(document)
				if staticChat and not staticChat:IsClassSet('console_style_initialized') then
					staticChat:SetClass('console_style_initialized', true)
					if gConsoleFloaty ~= true then
						ConsoleActivateStaticIds(document)
						ConsoleResetStaticPosition(document)
					end
				end
				return ''
			end

			function ConsoleSetStaticMessagesHidden(document, height_value)
				-- Keep the function as a no-op compatibility hook, but do not hide static
				-- messages during resize. The original 1406 static console handles shrinking
				-- cleanly with its log-spacer + column-reverse layout.
				if not document then return '' end
				local chat = ConsoleGetStaticRoot(document)
				if chat then chat:SetClass('console_static_messages_hidden', false) end
				return ''
			end

			function ConsoleUpdateStaticMessageVisibility(document)
				return ConsoleSetStaticMessagesHidden(document, nil)
			end

			function ConsoleClampStaticHeight(document)
				if not document then return '' end
				local chat = ConsoleGetStaticRoot(document)
				if not chat then return '' end
				chat.style.min_height = '124dp'
				chat.style.max_height = '500dp'
				local currentHeight = chat.offset_height or 250
				local finalHeight = currentHeight
				if currentHeight > 500 then
					chat.style.height = '500dp'
					finalHeight = 500
				elseif currentHeight < 124 then
					chat.style.height = '124dp'
					finalHeight = 124
				end
				return ''
			end



			function ConsoleStaticHandleLiveClamp(document)
				if not document then return '' end
				if gConsoleFloaty == true then return '' end
				local chat = ConsoleGetStaticRoot(document)
				if not chat then return '' end
				-- Keep the static pull-down resize anchored to the real static frame.
				-- Some customhandle drags can temporarily write top/left from the pointer;
				-- immediately put the frame back at the top-center while preserving height.
				chat.style.position = 'absolute'
				chat.style.top = '0dp'
				chat.style.left = '12%'
				chat.style.right = 'auto'
				chat.style.bottom = 'auto'
				chat.style.margin_top = '0dp'
				chat.style.margin_left = '0dp'
				chat.style.margin_right = '0dp'
				chat.style.width = '76%'
				chat.style.min_width = '76%'
				chat.style.max_width = '76%'
				chat.style.min_height = '124dp'
				chat.style.max_height = '500dp'
				local currentHeight = chat.offset_height or 250
				local finalHeight = currentHeight
				if currentHeight > 500 then
					chat.style.height = '500dp'
					finalHeight = 500
				elseif currentHeight < 124 then
					chat.style.height = '124dp'
					finalHeight = 124
				end
				-- Only while the pull handle is being dragged: keep the newest static lines
				-- attached to the bottom of the resized panel, without changing normal user scrolling.
				ConsoleScrollToBottom(document, chat)
				return ''
			end

			function ConsoleStaticHandleRefresh(document)
				-- Same clamp pass, used by resize/mouse fallback events. Message layout itself
				-- is restored to the original 1406 static console behavior.
				return ConsoleStaticHandleLiveClamp(document)
			end

			function ConsoleSetStaticFrame(document, reset_height)
				if not document then return '' end
				local chat = ConsoleGetStaticRoot(document)
				if not chat then return '' end
				chat.style.position = 'absolute'
				chat.style.top = '0dp'
				chat.style.left = '12%'
				chat.style.right = 'auto'
				chat.style.bottom = 'auto'
				chat.style.margin_top = '0dp'
				chat.style.margin_left = '0dp'
				chat.style.margin_right = '0dp'
				chat.style.width = '76%'
				chat.style.min_width = '76%'
				chat.style.max_width = '76%'
				chat.style.min_height = '124dp'
				chat.style.max_height = '500dp'
				if reset_height == true then
					chat.style.height = '250dp'
				else
					ConsoleClampStaticHeight(document)
				end
				return ''
			end

			function ConsoleCenterStaticFrame(document)
				return ConsoleSetStaticFrame(document, false)
			end

			function ConsoleResetStaticPosition(document)
				return ConsoleSetStaticFrame(document, true)
			end

			function ConsoleResetFloatyPosition(document)
				if not document then return '' end
				local chat = ConsoleGetFloatyRoot(document)
				if not chat then return '' end
				chat.style.top = '80dp'
				chat.style.right = '110dp'
				chat.style.left = 'auto'
				chat.style.width = '30vw'
				chat.style.height = '180dp'
				return ''
			end

			function ConsoleSetToggleButtons(document)
				if not document then return '' end
				local staticButton = document:GetElementById('style_toggle_static')
				if staticButton then staticButton:SetClass('console_toggle_active_floaty', gConsoleFloaty == true) end
				local floatyButton = document:GetElementById('style_toggle_floaty')
				if floatyButton then floatyButton:SetClass('console_toggle_active_floaty', gConsoleFloaty == true) end
				return ''
			end

			function ConsoleClearStyleAnimationClasses(document)
				if not document then return '' end
				local staticChat = ConsoleGetStaticRoot(document)
				local floatyChat = ConsoleGetFloatyRoot(document)
				local classes = {
					'console_anim_static_out_to_floaty',
					'console_anim_static_in_from_floaty',
					'console_anim_floaty_in_from_static',
					'console_anim_floaty_out_to_static'
				}
				for i, className in ipairs(classes) do
					if staticChat then staticChat:SetClass(className, false) end
					if floatyChat then floatyChat:SetClass(className, false) end
				end
				return ''
			end

			function ConsoleBeginStyleAnimation(document, target_floaty)
				if not document then return '' end
				ConsoleClearStyleAnimationClasses(document)
				local staticChat = ConsoleGetStaticRoot(document)
				local floatyChat = ConsoleGetFloatyRoot(document)
				if target_floaty == true then
					if staticChat then staticChat:SetClass('console_anim_static_out_to_floaty', true) end
					if floatyChat then floatyChat:SetClass('console_anim_floaty_in_from_static', true) end
				else
					if staticChat then staticChat:SetClass('console_anim_static_in_from_floaty', true) end
					if floatyChat then floatyChat:SetClass('console_anim_floaty_out_to_static', true) end
				end
				return ''
			end

			function ConsoleApplyStyleBridge(document)
				ConsoleEnsureStyleState(document)
				if not document then return '' end
				if gConsoleFloaty == true then
					ConsoleActivateFloatyIds(document)
				else
					ConsoleActivateStaticIds(document)
				end
				local staticChat = ConsoleGetStaticRoot(document)
				local floatyChat = ConsoleGetFloatyRoot(document)
				if staticChat then staticChat:SetClass('console_style_hidden', gConsoleFloaty == true) end
				if floatyChat then floatyChat:SetClass('console_style_hidden', gConsoleFloaty ~= true) end
				ConsoleSetToggleButtons(document)
				return ''
			end

			function ConsoleToggleConsoleStyle(event, document)
				ConsoleEnsureStyleState(document)
				local targetFloaty = not gConsoleFloaty
				ConsoleBeginStyleAnimation(document, targetFloaty)
				gConsoleFloaty = targetFloaty
				if gConsoleFloaty then
					ConsoleResetFloatyPosition(document)
				else
					ConsoleResetStaticPosition(document)
				end
				ConsoleApplyStyleBridge(document)
				if event then event:StopPropagation() end
				return ''
			end

		</script>
	</head>
	<body>
		<div id="console_style_startup_loader" data-rml="ConsoleStartupAndApply(document)"/>
		<div id="chat_window" class="chat_region console_static_panel" data-model="ConsoleModel" data-class-hidden="!ConsoleModel.IsShown" onshow="ConsoleStaticOnShow(document, element)">

			<form id="filter" name="duration" data-value="ConsoleModel.Filter" onclick="OnEvent(event, 'Console.OnFilter') ConsoleScrollToBottom(document, element)">
				<input type="radio" id="filter_all" value="0" data-checked="ConsoleModel.Filter" data-disabled="ConsoleModel.AccountAgeType == 3"/>
				<label id="filter_label_all" for="filter_all" class="filter_btn filter_all_clr">
					<span class="icon filter_all"></span>
					<div class="filter_name" data-class-hidden="ConsoleModel.Filter != 0">All</div>
				</label>

				<input type="radio" id="filter_world" value="1" data-checked="ConsoleModel.Filter"  data-disabled="ConsoleModel.AccountAgeType == 3"/>
				<label id="filter_label_world" for="filter_world" class="filter_btn filter_world_clr">
					<span class="icon filter_world"></span>
					<div class="filter_name" data-class-hidden="ConsoleModel.Filter != 1">World</div>
				</label>

				<input type="radio" id="filter_private" value="2" data-checked="ConsoleModel.Filter" />
				<label id="filter_label_private" for="filter_private" class="filter_btn filter_private_clr">
					<span class="icon filter_private"></span>
					<div class="filter_name" data-class-hidden="ConsoleModel.Filter != 2">Private</div>
				</label>

				<input type="radio" id="filter_system" value="3" data-checked="ConsoleModel.Filter" />
				<label id="filter_label_system" for="filter_system" class="filter_btn filter_system_clr">
					<span class="icon filter_system"></span>
					<div class="filter_name" data-class-hidden="ConsoleModel.Filter != 3">System</div>
				</label>

				<input type="radio" id="filter_custom" value="4" data-checked="ConsoleModel.Filter"  data-disabled="ConsoleModel.AccountAgeType == 3"/>
				<label id="filter_label_custom" for="filter_custom" class="filter_btn filter_custom_clr">
					<span class="icon filter_custom"></span>
					<div class="filter_name" data-class-hidden="ConsoleModel.Filter != 4">Custom</div>
				</label>

				<div class="chat_settings" data-class-hidden="ConsoleModel.Filter != 4" onclick="OnEvent(element, 'Console.OnClickCustomSettings')">
					<div id="chat_image"/>
				</div>

				<div id="style_toggle_static" class="chat_settings console_style_toggle" onclick="ConsoleToggleConsoleStyle(event, document)">
					<div class="console_style_icon"/>
				</div>
			</form>

			<div id="custom-settings-popup" class="popup hidden">
				<div style="padding: 8dp;">Select the content to be shown on the Custom tab</div>
				<form id="custom-settings" class="checkbox-group" onchange="OnEvent(event, 'Console.OnCustomSettingsChange')">
					<label class="checkbox-row">
						<input type="checkbox" filter-type="Global" value="0" data-checked="ConsoleModel.GlobalMessages"/>
						<span class="label">Global Messages</span>
					</label>
					<label class="checkbox-row">
						<input type="checkbox" filter-type="Global" value="1" data-checked="ConsoleModel.WorldMessages"/>
						<span class="label">World Messages</span>
					</label>
					<label class="checkbox-row">
						<input type="checkbox" filter-type="Global" value="2" data-checked="ConsoleModel.PrivateMessages"/>
						<span class="label">Private Messages</span>
					</label>
					<label class="checkbox-row">
						<input type="checkbox" filter-type="Global" value="3" data-checked="ConsoleModel.FriendMessages"/>
						<span class="label">Friend Messages</span>
					</label>
					<label class="checkbox-row">
						<input type="checkbox" filter-type="Global" value="4" data-checked="ConsoleModel.GuildMessages"/>
						<span class="label">Guild Messages</span>
					</label>
					<label class="checkbox-row">
						<input type="checkbox" filter-type="Global" value="5" data-checked="ConsoleModel.SystemMessages"/>
						<span class="label">Game/System Messages</span>
					</label>
				</form>
			</div>

			<div class="preview-panel" data-class-hidden="!ConsoleModel.InputSpecialChars">
				<div id="preview-content">
					<div id="preview-text" data-rml="ToRMLText(ConsoleModel.PreviewText)"/>
				</div>
			</div>

			<div class="log-panel" id="log-top" onshow="ConsoleScrollToBottom(document, element)">
				<div class="show-scrollbar wondow-content-full" id="log-content" onshow="ConsoleScrollToBottom(document, element)">
					<div id="log-spacer"></div>
					<div id="log-lines" onlistupdated="ConsoleScrollToBottom(document, element)">
						<div data-for="Line : ConsoleModel.ShowLogLines" onlistupdated="ConsoleScrollToBottom(document, element)">
							<div class="chat_padding" onshow="ConsoleScrollToBottom(document, element)">
								<div id="text-line" data-rml="ToRMLText(ConsoleLogText(Line))" data-class-hidden="ConsoleLogDisplayType(Line) != 0"/>
								<div class="crazy_jim_panel" data-class-hidden="ConsoleLogDisplayType(Line) != 1">
									<div id="image" />
									<div id="text" data-rml="ToRMLText(ConsoleLogText(Line))" />
								</div>
							</div>
						</div>
						<div id="scroll-anchor" data-rml="ConsoleScrollToBottomForLines(document, element, len(ConsoleModel.ShowLogLines))"/>
					</div>
				</div>
			</div>

			<div class="input-panel">
				<div id="input-content">
					<input id="input-text" type="text" maxlength="120" data-value="ConsoleModel.InputText"
							onkeyup="MaybeCloseChatOnEnter(event, document) OnEvent(event, 'Console.HandleInput')"
							onblur="ResetConsoleEnterArm() OnEvent(event, 'Console.HandleInputFocusEnd')"
							onfocus="ConsoleScrollToBottom(document, element) OnEvent(event, 'Console.HandleInputFocusBegin')"/>
					<div id="input-info" data-rml="len(ConsoleModel.InputText)+'/120'"/>
				</div>
			</div>

			<div id="msg-hint-panel" class="message-hint-panel" data-class-hidden="len(ConsoleModel.InputText) > 0">
				<div id="message-hint-text">Enter message...</div>
			</div>
			
			<customhandle id="pull_down_button" size_target="chat_window" edge_margin="10dp 20dp 10dp 10dp" onmousedown="ConsoleHandlePress(document)" onmousemove="ConsoleStaticHandleLiveClamp(document)" onmousedrag="ConsoleStaticHandleLiveClamp(document)" ondrag="ConsoleStaticHandleLiveClamp(document)" onmouseup="ConsoleStaticHandleLiveClamp(document) ConsoleCenterStaticFrame(document)" onclick="ConsoleToggleChatHeight(event, document)">
				<div id="pull_down_icon"></div>
			</customhandle>

		</div>

		<!-- Floaty console: copied from Consoleagainfromdeove and kept isolated; visibility is controlled only by the style toggle. -->
<div id="chat_window_floaty" class="console_floaty_panel console_style_hidden" data-model="ConsoleModel" data-class-hidden="!ConsoleModel.IsShown">

			<!-- Special Characters Preview -->
			<div class="floaty_preview-panel" data-class-hidden="!ConsoleModel.InputSpecialChars">
				<div id="preview-content_floaty">
					<div id="preview-text_floaty" data-rml="ToRMLText(ConsoleModel.PreviewText)"/>
				</div>
			</div>
			
			<!-- Empty input hint -->
			<div class="floaty_message-hint-panel" data-class-hidden="len(ConsoleModel.InputText) > 0">
				<div id="message-hint-text_floaty">Enter Message Here</div>
			</div>

			<!-- Filter Buttons -->
			<form id="filter_floaty" name="duration" data-value="ConsoleModel.Filter" onclick="OnEvent(event, 'Console.OnFilter')">
				<input type="radio" id="filter_all_floaty" value="0" data-checked="ConsoleModel.Filter" data-disabled="ConsoleModel.AccountAgeType == 3"/>
				<label id="filter_label_all_floaty" for="filter_all_floaty" class="floaty_filter_btn floaty_filter_all_clr">
					<span class="floaty_icon floaty_filter_all"></span>
					<div class="floaty_filter_name" data-class-hidden="ConsoleModel.Filter != 0">All</div>
				</label>

				<input type="radio" id="filter_world_floaty" value="1" data-checked="ConsoleModel.Filter"  data-disabled="ConsoleModel.AccountAgeType == 3"/>
				<label id="filter_label_world_floaty" for="filter_world_floaty" class="floaty_filter_btn floaty_filter_world_clr">
					<span class="floaty_icon floaty_filter_world"></span>
					<div class="floaty_filter_name" data-class-hidden="ConsoleModel.Filter != 1">World</div>
				</label>

				<input type="radio" id="filter_private_floaty" value="2" data-checked="ConsoleModel.Filter" />
				<label id="filter_label_private_floaty" for="filter_private_floaty" class="floaty_filter_btn floaty_filter_private_clr">
					<span class="floaty_icon floaty_filter_private"></span>
					<div class="floaty_filter_name" data-class-hidden="ConsoleModel.Filter != 2">Private</div>
				</label>

				<input type="radio" id="filter_system_floaty" value="3" data-checked="ConsoleModel.Filter" />
				<label id="filter_label_system_floaty" for="filter_system_floaty" class="floaty_filter_btn floaty_filter_system_clr">
					<span class="floaty_icon floaty_filter_system"></span>
					<div class="floaty_filter_name" data-class-hidden="ConsoleModel.Filter != 3">System</div>
				</label>

				<input type="radio" id="filter_custom_floaty" value="4" data-checked="ConsoleModel.Filter"  data-disabled="ConsoleModel.AccountAgeType == 3"/>
				<label id="filter_label_custom_floaty" for="filter_custom_floaty" class="floaty_filter_btn floaty_filter_custom_clr">
					<span class="floaty_icon floaty_filter_custom"></span>
					<div class="floaty_filter_name" data-class-hidden="ConsoleModel.Filter != 4">Custom</div>
				</label>

				<div class="floaty_chat_settings" data-class-hidden="ConsoleModel.Filter != 4" onclick="OnEvent(element, 'Console.OnClickCustomSettings')">
					<div id="chat_image_floaty"/>
				</div>

				<div id="style_toggle_floaty" class="floaty_chat_settings console_style_toggle" onclick="ConsoleToggleConsoleStyle(event, document)">
					<div class="console_style_icon"/>
				</div>
			</form>

			<!-- Custom Settings Popup -->
			<div id="custom-settings-popup_floaty" class="floaty_popup hidden">
				<div style="padding: 8dp;">Select the content to be shown on the Custom tab</div>
				<form id="custom-settings_floaty" class="floaty_checkbox-group" onchange="OnEvent(event, 'Console.OnCustomSettingsChange')">
					<label class="floaty_checkbox-row">
						<input type="checkbox" filter-type="Global" value="0" data-checked="ConsoleModel.GlobalMessages"/>
						<span class="floaty_label">Global Messages</span>
					</label>
					<label class="floaty_checkbox-row">
						<input type="checkbox" filter-type="Global" value="1" data-checked="ConsoleModel.WorldMessages"/>
						<span class="floaty_label">World Messages</span>
					</label>
					<label class="floaty_checkbox-row">
						<input type="checkbox" filter-type="Global" value="2" data-checked="ConsoleModel.PrivateMessages"/>
						<span class="floaty_label">Private Messages</span>
					</label>
					<label class="floaty_checkbox-row">
						<input type="checkbox" filter-type="Global" value="3" data-checked="ConsoleModel.FriendMessages"/>
						<span class="floaty_label">Friend Messages</span>
					</label>
					<label class="floaty_checkbox-row">
						<input type="checkbox" filter-type="Global" value="4" data-checked="ConsoleModel.GuildMessages"/>
						<span class="floaty_label">Guild Messages</span>
					</label>
					<label class="floaty_checkbox-row">
						<input type="checkbox" filter-type="Global" value="5" data-checked="ConsoleModel.SystemMessages"/>
						<span class="floaty_label">Game/System Messages</span>
					</label>
				</form>
			</div>

			<!-- Input Panel -->
			<div class="floaty_input-panel">
				<div id="input-content_floaty"  style="width:100%;">
					<input id="input-text_floaty" type="text" maxlength="120" data-value="ConsoleModel.InputText"
							onkeyup="OnEvent(event, 'Console.HandleInput')"
							onblur="OnEvent(event, 'Console.HandleInputFocusEnd')"
							onfocus="OnEvent(event, 'Console.HandleInputFocusBegin')"/>
					<div id="input-info_floaty" data-rml="len(ConsoleModel.InputText)+'/120'"/>
				</div>
				<handle id="move_handle_floaty" move_target="chat_window_floaty" edge_margin="10dp 20dp 10dp 10dp"/>
			</div>

			<!-- Log Panel -->
			<div class="floaty_log-panel" id="log-top_floaty">
				<div class="show-scrollbar wondow-content-full wondow-content-horizontal" id="log-content_floaty">
					<div data-for="Line : ConsoleModel.ShowLogLines">
						<div class="floaty_chat_padding" data-class-alternate="IsOdd(Line)">
							<div id="text-line_floaty" data-rml="ToRMLText(ConsoleLogText(Line))" data-class-hidden="ConsoleLogDisplayType(Line) != 0"/>
							<div class="floaty_crazy_jim_panel" data-class-hidden="ConsoleLogDisplayType(Line) != 1">
								<div id="image_floaty" />
								<div id="text_floaty" data-rml="ToRMLText(ConsoleLogText(Line))" />
							</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Resize Handle -->
				<customhandle id="resize_bl_floaty" class="floaty_resize_handle floaty_handle_bl" size_target="chat_window_floaty" edge_margin="10dp 20dp 10dp 10dp"/>
			
		</div>

		<div id="console_style_bridge_loader" data-rml="ConsoleStartupAndApply(document)"/>

		<div id="console_static_final_position_loader" data-rml="ConsoleStartupFinalizeStatic(document)"/>
	</body>
</template>
