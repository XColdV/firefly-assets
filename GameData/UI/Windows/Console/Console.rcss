@spritesheet checkbox_sprites {
    src: interface/checkbox.rttex;
    resolution: 1x;
    checkbox_off_icon: 0px 0px 32px 32px;
    checkbox_on_icon: 32px 0px 32px 32px;
}

/* ============================================================
   MAIN CHAT WINDOW CONTAINER
   Positioned in the bottom-left of the screen.
   Height is resizable via the handle.
============================================================ */
.chat_region {
    position: absolute;
    left: 8dp;
    right: 122dp;
    top: 8dp;
    z-index: 10;

    width: auto;
    height: 350dp;
    min-width: 360dp;
    min-height: 120dp;
    max-height: 82vh;

    padding: 0dp;
    border-radius: 7dp;
    background-color: rgba(4, 12, 18, 0);
    font-effect: shadow(1dp 1dp #000);
}

.hide #chat_window,
.full-hide #chat_window {
    display: none;
}

/* ============================================================
   LOG PANEL — The entire chat widget container
   Uses column layout: log area grows, input+filter are fixed bottom
============================================================ */
.log-panel {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 4dp;
    padding: 6dp 6dp 6dp 6dp;
    border-radius: 7dp;
    border: 1dp rgba(128, 204, 232, 160);
    background-color: rgba(8, 28, 40, 185);
    box-shadow: #000d 2dp 2dp 8dp 0dp;
    overflow: hidden;
    position: relative;
    box-sizing: border-box;
}

/* ============================================================
   LOG CONTENT AREA
   This is the scrollable area for chat messages.
   It flex-grows to fill all space above the input.
   Messages are anchored to the bottom: newest = bottom.
   Scrolling UP reveals older messages.
============================================================ */
#log-content {
    flex: 1 1 0px;
    width: 100%;
    /* Critical: overflow-y scroll allows scrolling up for history */
    overflow-y: scroll;
    overflow-x: hidden;
    font-size: 0.84rem;
    border-radius: 4dp;
    background-color: transparent;

    /* 
     * Use display:flex + flex-direction:column so that the inner #log-lines
     * can use justify-content:flex-end to push content to the bottom.
     */
    display: flex;
    flex-direction: column;
}

/* ============================================================
   LOG LINES INNER WRAPPER
   justify-content: flex-end pushes all messages to the BOTTOM.
   When there are few messages, they appear at bottom not top.
   When full, scroll starts at bottom (newest) and you scroll UP for history.
============================================================ */
#log-lines {
    display: flex;
    /*
     * column-reverse: DOM order is newest-first (index 0 = newest from model).
     * column-reverse flips visual order so newest = BOTTOM, oldest = TOP.
     * scroll_top = 0 means you are at the visual bottom (newest messages).
     * Scrolling UP (drag scrollbar up) reveals older messages at the top.
     */
    flex-direction: column-reverse;
    justify-content: flex-start;
    align-items: flex-start;
    width: 100%;
    min-height: 100%;
    flex: 1 0 auto;
    padding: 4dp 6dp 4dp 4dp;
    box-sizing: border-box;
}

/* Individual chat message row */
.chat_padding {
    width: 100%;
    padding: 1dp 3dp 1dp 3dp;
    border-radius: 3dp;
    background-color: rgba(255, 255, 255, 0);
    box-sizing: border-box;
}

.chat_padding.alternate {
    display: block;
    background-color: rgba(255, 255, 255, 10);
}

/* Text line for normal chat */
#text-line {
    padding: 1dp 4dp 1dp 4dp;
    line-height: 1.35;
    width: 100%;
    word-wrap: break-word;
    overflow-wrap: break-word;
}

/* NPC / Crazy Jim panel */
.crazy_jim_panel {
    display: flex;
    flex-direction: row;
    gap: 8dp;
    align-items: flex-start;
    width: 100%;
    padding: 3dp;
}

#image {
    min-width: 48dp;
    width: 48dp;
    height: 48dp;
    decorator: image(interface/tutorial/tut_npc.rttex);
}

#text {
    color: rgb(236, 248, 255);
    line-height: 1.35;
}

/* ============================================================
   INPUT PANEL — Fully transparent background, sits below logs
============================================================ */
.input-panel {
    flex-shrink: 0;
    width: 100%;
    min-height: 36dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
    border-radius: 5dp;
    /* Fully transparent - just a subtle bottom border line */
    border: 1dp rgba(135, 184, 204, 60);
    background-color: transparent;
    padding: 2dp 4dp;
    box-sizing: border-box;
}

#input-content {
    width: 100%;
    display: flex;
    flex-direction: row;
    position: relative;
    align-items: center;
    background-color: transparent;
}

#input-text {
    display: block;
    width: 100%;
    color: rgb(245, 252, 255);
    padding: 4dp 8dp 4dp 8dp;
    border-radius: 4dp;
    font-size: 0.85rem;
    font-weight: bold;
    line-height: 28dp;
    /* Fully transparent input field */
    background-color: transparent;
    border: none;
}

#input-info {
    display: block;
    text-align: center;
    line-height: 28dp;
    min-width: 68dp;
    padding: 0dp 5dp;
    font-size: 0.70rem;
    color: rgba(200, 230, 245, 150);
    border-radius: 4dp;
    background-color: rgba(40, 80, 100, 80);
    flex-shrink: 0;
}

/* Message hint placeholder — fully transparent styled */
.message-hint-panel {
    width: auto;
    padding: 0dp;
    display: block;
    position: absolute;
    left: 12dp;
    top: 50%;
    z-index: 20;
    font-size: 0.75rem;
    /* Very faint, transparent placeholder color */
    color: rgba(200, 230, 245, 60);
    pointer-events: none;
    font-style: italic;
}

/* Preview panel for special characters */
.preview-panel {
    width: auto;
    min-width: 300dp;
    max-width: 75vw;
    padding: 0dp;
    display: flex;
    flex-direction: row;
    position: absolute;
    left: 4dp;
    bottom: 44dp;
    z-index: 20;
    border-radius: 6dp;
    border: 1dp rgba(135, 184, 204, 150);
    background-color: rgba(18, 46, 61, 238);
    box-shadow: #0009 1dp 1dp 4dp 0dp;
}

#preview-content {
    padding: 0dp;
    position: relative;
}

#preview-text {
    display: block;
    width: 100%;
    padding: 5dp 10dp 4dp 10dp;
    border-radius: 6dp;
    color: #fff;
    font-size: 0.76rem;
    font-weight: bold;
    line-height: 28dp;
}

/* ============================================================
   FILTER BUTTONS ROW
   flex-shrink:0 so they stay at fixed height.
   Hidden (display:none) when chat_region height is too small.
============================================================ */
#filter {
    flex-shrink: 0;
    width: 100%;
    height: 38dp;
    display: flex;
    flex-direction: row;
    gap: 4dp;
    align-items: center;
    padding: 0dp;
    overflow: hidden;
    box-sizing: border-box;
}

/* Auto-hide filter row when the window is very short */
.chat_region {
    /* baseline for attribute selector workaround */
}

#filter input[type="radio"] {
    display: none;
}

#filter label.filter_btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36dp;
    padding: 3dp 8dp 3dp 6dp;
    opacity: 0.80;
    border-radius: 6dp;
    border: 1dp rgba(160, 212, 232, 100);
    background-color: rgba(20, 44, 58, 200);
    box-shadow: #0008 1dp 1dp 3dp 0dp;
    sound-on-click: true;
    transition: all 0.12s ease-out;
    flex-shrink: 0;
}

#filter label.filter_btn:hover {
    opacity: 1.0;
    background-color: rgba(44, 78, 98, 230);
}

#filter input[type="radio"]:checked + label {
    opacity: 1.0;
    background-color: rgba(60, 120, 155, 240);
    border: 1dp rgba(200, 238, 252, 210);
    box-shadow: #0008 1dp 2dp 5dp 0dp;
}

#filter .icon {
    width: 26dp;
    height: 26dp;
    display: block;
}

.filter_name {
    position: relative;
    top: 0dp;
    padding: 3dp 2dp 2dp 7dp;
    font-size: 0.72rem;
    font-weight: bold;
    color: rgb(230, 248, 255);
}

.filter_all_clr,
.filter_world_clr,
.filter_private_clr,
.filter_system_clr,
.filter_custom_clr {
    image-color: rgba(255, 255, 255, 245);
}

.filter_all     { decorator: image(interface/large/gui_chat_all.rttex); }
.filter_world   { decorator: image(interface/large/gui_chat_world.rttex); }
.filter_private { decorator: image(interface/large/gui_chat_private.rttex); }
.filter_system  { decorator: image(interface/large/gui_chat_system.rttex); }
.filter_custom  { decorator: image(interface/large/gui_chat_custom.rttex); }

/* Chat Settings gear/cog button */
.chat_settings {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 38dp;
    height: 36dp;
    padding: 4dp;
    border-radius: 6dp;
    border: 1dp rgba(224, 190, 238, 150);
    background-color: rgba(100, 62, 120, 210);
    box-shadow: #0008 1dp 1dp 3dp 0dp;
    sound-on-click: true;
    transition: all 0.12s ease-out;
    flex-shrink: 0;
}

.chat_settings:hover {
    background-color: rgba(125, 78, 145, 240);
}

.chat_settings:active {
    filter: brightness(0.85);
}

#chat_image {
    width: 26dp;
    height: 26dp;
    decorator: image(interface/large/chat_settings.rttex);
    align-self: center;
}

/* ============================================================
   CUSTOM SETTINGS POPUP
   Anchored above the filter row (bottom: filter_height + gap)
   Floats above without covering log messages.
============================================================ */
.popup {
    position: absolute;
    left: 0dp;
    right: 0dp;
    /* Position it just above the filter bar + input bar */
    bottom: 88dp;
    width: auto;
    padding: 0dp;
    z-index: 100;
    border-radius: 7dp;
    border: 1dp rgba(160, 210, 235, 200);
    background-color: rgba(14, 34, 48, 248);
    box-shadow: #000b 2dp 2dp 8dp 0dp;
    font-size: 0.76rem;
}

.popup.hidden {
    display: none;
}

.checkbox-group {
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 4dp;
    padding: 10dp 12dp;
}

.checkbox-group .label {
    vertical-align: middle;
    text-align: left;
    font-size: 0.76rem;
    color: rgb(240, 250, 255);
}

.checkbox-row {
    display: flex;
    align-items: center;
    gap: 10dp;
    padding: 4dp 6dp;
    border-radius: 4dp;
    sound-on-click: true;
    transition: background-color 0.10s ease-out;
}

.checkbox-row:hover {
    background-color: rgba(255, 255, 255, 18);
}

.checkbox {
    height: 16dp;
    width: 16dp;
    display: inline-block;
    padding: 5dp;
    text-align: center;
    vertical-align: middle;
    sound-on-click: true;
    decorator: image(checkbox_off_icon);
}

.checkbox:checked {
    decorator: image(checkbox_on_icon);
}

/* ============================================================
   RESIZE HANDLE
   Absolutely positioned at the very bottom of .log-panel.
   Small subtle tab that the user grabs to resize vertically.
============================================================ */
.resize_handle {
    width: 100dp;
    height: 10dp;
    padding: 0dp;
    position: absolute;
    left: 50%;
    bottom: 0dp;
    cursor: s-resize;
    border-radius: 5dp 5dp 0dp 0dp;
    background-color: rgba(135, 184, 204, 70);
    transition: background-color 0.12s ease-out;
    /* Center horizontally */
    margin-left: -50dp;
}

.resize_handle:hover {
    background-color: rgba(135, 184, 204, 140);
}

.resize_handle:active {
    background-color: rgba(135, 184, 204, 200);
}

/* ============================================================
   SCROLLBAR STYLING
============================================================ */
#log-content scrollbarvertical {
    width: 8dp;
    margin-left: 2dp;
}

#log-content scrollbarvertical slidertrack {
    background-color: rgba(20, 40, 52, 100);
    border-radius: 4dp;
}

#log-content scrollbarvertical sliderbar {
    background-color: rgba(100, 160, 185, 140);
    border-radius: 4dp;
    min-height: 24dp;
}

#log-content scrollbarvertical sliderbar:hover {
    background-color: rgba(130, 190, 215, 200);
}

#log-content scrollbarvertical sliderbar:active {
    background-color: rgba(155, 215, 235, 240);
}
