@spritesheet event_button4_sprite {
    src: interface/large/event_button4.rttex;
    resolution: 1x;
    notification_icon_circle: 256px 384px 128px 128px;
}

/* ============================================================
   RIGHT MENU PANEL CONTAINER
   Dark glassmorphism card — top-right of screen
============================================================ */
#right_menu_panel {
    padding: 6dp;
    display: flex;
    flex-direction: column;
    gap: 5dp;
    border-radius: 12dp;
    border: 1dp rgba(128, 204, 232, 155);
    background-color: rgba(8, 20, 30, 210);
    box-shadow: #000e 2dp 3dp 4dp 0dp;
}

/* ============================================================
   MAIN BUTTONS COLUMN WIDTH
============================================================ */
#main_buttons {
    width: 56dp;
    display: flex;
    flex-direction: column;
    gap: 5dp;
}

/* ============================================================
   MENU BUTTONS — Premium glassy look
============================================================ */
.menu-button {
    width: 56dp;
    height: 56dp;
    border-radius: 10dp;
    border: 1dp rgba(128, 204, 232, 90);
    background-color: rgba(20, 55, 75, 210);
    box-shadow: #000b 1dp 2dp 5dp 0dp, inset #ffffff0a 0dp 1dp 0dp 0dp;
    sound-on-click: true;
    transition: background-color 0.12s ease-out, border 0.12s ease-out, box-shadow 0.12s ease-out, transform 0.12s ease-out;
    position: relative;
}

.menu-button:hover {
    background-color: rgba(35, 80, 108, 240);
    border: 1dp rgba(160, 220, 245, 150);
    box-shadow: #000d 1dp 2dp 7dp 0dp, inset #ffffff12 0dp 1dp 0dp 0dp;
}

.menu-button:active {
    transform: scale(0.90);
    background-color: rgba(12, 35, 50, 210);
    box-shadow: #0008 0dp 1dp 3dp 0dp;
}

/* ============================================================
   BUTTON DECORATORS
============================================================ */
.menuopen-button {
    decorator: image("interface/large/menu_button.rttex" contain);
}

.chat-button {
    decorator: image("interface/large/chat_button.rttex" contain);
}

.friend-button {
    decorator: image("interface/large/friend_button.rttex" contain);
}

.shop-button {
    decorator: image("interface/large/shop_button.rttex" contain);
}

/* Photo button — sits above the main group */
.photo-button {
    decorator: image("interface/large/PhotomodeOff.rttex" contain);
    border: 1dp rgba(200, 160, 240, 100);
    background-color: rgba(55, 25, 75, 200);
}

.photo-button:hover {
    background-color: rgba(80, 38, 105, 240);
    border: 1dp rgba(210, 170, 250, 160);
}

.hide .photo-button {
    decorator: image("interface/large/PhotomodeOn.rttex" contain);
    background-color: rgba(120, 55, 160, 220);
    border: 1dp rgba(220, 180, 255, 180);
    box-shadow: #8844cc88 0dp 0dp 8dp 0dp;
}

/* ============================================================
   VISIBILITY RULES
============================================================ */
.petbattle-hide .menuopen-button,
.petbattle-hide .shop-button,
.petbattle-hide .photo-button,
.petbattle-hide .friend-button,
.ftue-hide .menuopen-button,
.ftue-hide .chat-button,
.ftue-hide .shop-button,
.ftue-hide .photo-button,
.ftue-hide .friend-button {
    display: none;
}

/* ============================================================
   NOTIFICATION BADGE on Chat Button
============================================================ */
.notification_circle {
    position: absolute;
    width: 46dp;
    height: 46dp;
    decorator: image(notification_icon_circle);
    margin-left: -12dp;
    margin-top: -12dp;
}

.notification_text {
    position: absolute;
    width: 46dp;
    height: 46dp;
    text-align: center;
    line-height: 46dp;
    vertical-align: middle;
    font-size: 0.65rem;
    font-weight: bold;
    color: rgb(255, 255, 255);
    font-effect: shadow(1dp 1dp black);
}
