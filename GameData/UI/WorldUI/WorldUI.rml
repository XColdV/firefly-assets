<rml>
    <head>
        <title>WorldUI</title>
        <link type="text/rcss" href="WorldUI.rcss" />
        <link type="text/template" href="../BaseTemplate.rml" />
        <link type="text/template" href="RightMenuPanel.rml" />
		<link type="text/template" href="../Windows/Console/Console.rml" />
        <script lang="text/lua">
            function onShowUI(document, element)
            local insets = GetInsets()
            element.style.width = (element.client_width - insets[1]).."px"

            local sidebar = element:GetElementById('right_sidebar')
            if sidebar then
                sidebar.style.right = (10 + insets[2]).."dp"
            end

            element:SetClass('full-hide', false)
            end
        </script>
    </head>
    <body template="BaseTemplate" class="world_ui full-hide" onshow="onShowUI(document, element)">

		<!-- Right sidebar: menu buttons at top, gems below, anchored to right inset -->
		<div id="right_sidebar">
			<div id="right_panel">
				<template src="RightMenuPanel" />
			</div>

			<FeatureEnableFlag flag-id="EnableProfileHUD">
				<div id="top_panel" data-model="PlayerInfoModel">
					<div id="gems_panel">
						<div class="panel" onclick="OnEvent(event, 'world_ui.gems_panel_click')" data-attrif-disabled="1">
							<div id="gem_left_panel">
								<div id="gem_icon"></div>
							</div>
							<div id="gem_right_panel">
								{{PlayerInfo.gemsCount}}
							</div>
						</div>
					</div>
				</div>
			</FeatureEnableFlag>
		</div>

		<template src="Console" />
    </body>
</rml>
