body.world_ui {
    width: 100%;
    height: 100%;
    clip: always;
    margin-left: inset-left;
}

/* ============================================================
   RIGHT SIDEBAR — Flex container for right_panel + gems
   Anchored to top-right, uses inset-right for camera offset
============================================================ */
#right_sidebar {
    display: flex;
    flex-direction: column;
    position: absolute;
    top: 10dp;
    right: 10dp;
    z-index: 8;
    gap: 8dp;
}

/* ============================================================
   RIGHT PANEL — Top-right, contains menu buttons
   Slides in/out with transition
============================================================ */
#right_panel {
    display: block;
    transition: margin-right 0.2s linear-in;
    margin-right: 0dp;
}

/* .hide = user toggled photo mode / hide UI.
   Keep the right_panel in place — only collapse main_buttons.
   This ensures the photo/toggle button stays always visible. */
.hide #right_panel {
    margin-right: 0dp;
}

/* Hide just the nav buttons, NOT the photo toggle button */
.hide #main_buttons {
    display: none;
}

/* full-hide = game-driven state (loading, cutscenes etc) — hide everything */
.full-hide #right_panel {
    margin-right: -120dp;
}

/* ============================================================
   TOP PANEL (Gems) — Below the right menu panel via flex layout
   No longer hardcoded top: 360dp — flows naturally
============================================================ */
#top_panel {
    display: block;
    transition: margin-top 0.2s linear-in, opacity 0.2s linear-in;
    margin-top: 0dp;
}

.ftue-hide #top_panel,
.full-hide #top_panel,
.petbattle-hide #top_panel,
.hide #top_panel {
    margin-top: -70dp;
    opacity: 0;
}

/* ============================================================
   GEMS PANEL — Premium dark glassmorphism design
============================================================ */
#gems_panel {
    width: 110dp;
    height: 48dp;
    padding: 4dp;
    display: flex;
    flex-direction: row;
    border-radius: 10dp;
    border: 1dp rgba(128, 204, 232, 160);
    background-color: rgba(8, 22, 32, 200);
    box-shadow: #000b 2dp 2dp 3dp 0dp;
}

#gems_panel .panel {
    width: 100%;
    height: 40dp;
    display: flex;
    flex-direction: row;
    align-items: center;
    border-radius: 7dp;
    background-color: rgba(30, 75, 100, 230);
    box-shadow: inset #0005 0dp 1dp 2dp 0dp, #0008 0dp 1dp 2dp 0dp;
    sound-on-click: true;
    transition: background-color 0.12s ease-out;
    overflow: hidden;
}

#gems_panel .panel:hover {
    background-color: rgba(44, 95, 122, 240);
}

#gems_panel .panel:active,
#gems_panel .panel:active * {
    image-color: #aaa;
    color: #aaa;
    background-color: rgba(22, 58, 78, 220);
}

/* Gem icon area - accent left strip */
#gems_panel #gem_left_panel {
    width: 34dp;
    height: 40dp;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    border-top-left-radius: 7dp;
    border-bottom-left-radius: 7dp;
    background-color: rgba(60, 150, 190, 220);
}

#gems_panel .panel:active #gem_left_panel {
    background-color: rgba(40, 110, 145, 210);
}

#gems_panel #gem_icon {
    width: 22dp;
    height: 22dp;
    decorator: image(interface/cash_icon_overlay.rttex);
}

/* Gem count text */
#gems_panel #gem_right_panel {
    flex: 1;
    display: block;
    text-align: center;
    font-size: 84%;
    font-weight: bold;
    color: rgb(220, 248, 255);
    white-space: nowrap;
    overflow: hidden;
    padding: 0dp 4dp;
    line-height: 40dp;
}

/*-------------------------------------------------------------------------------*/
