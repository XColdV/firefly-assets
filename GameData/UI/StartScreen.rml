<rml>
    <head>
        <title>StartScreen</title>
        <link type="text/rcss" href="StartScreen.rcss" />
        <link type="text/template" href="BaseTemplate.rml" />
        <script lang="text/lua">
        function showElement(document, id)
            el = document:GetElementById(id)
            if el then
                el:SetClass("display", true)
            end
        end

        function onShow(document)
            showElement(document, 'navbar')
            showElement(document, 'hero-content')
            showElement(document, 'account-strip')
            showElement(document, 'version-text')
            showElement(document, 'footer-text')
            showElement(document, 'logout_button')

            buttonPanel = document:GetElementById('platform-buttons')
            if buttonPanel then
                for i, child in ipairs(buttonPanel.child_nodes) do
                    child.style.transition = 'transform 0.48s '.. (i-1) * 0.12 ..'s linear-in-out, opacity 0.48s '.. (i-1) * 0.12 ..'s linear-in-out'
                    child:SetClass("display", true)
                end
            end
        end

        function playStart(document, element)
            overlay = document:GetElementById('launch-overlay')
            if overlay then
                overlay:SetClass('active', true)
            end
            OnEvent(element, 'on-start-game')
        end
        </script>
    </head>

    <body template="BaseTemplate" class="start-screen" onshow="onShow(document)" data-model="AppContext">
        <div id="background-clip">
            <div id="bg-video"></div>
            <div id="video-overlay"></div>
        </div>

        <div id="navbar">
            <div class="nav-left"></div>
            <div class="nav-center">
                <div class="logo-stage">
                    <div class="firefly-logo firefly-logo-base"></div>
                </div>
            </div>
            <div class="nav-right"></div>
        </div>

        <div id="hero-content">
            <div class="hero-emblem"></div>
            <div class="title">FIREFLY: NEW DAWN</div>
            <div class="hero-subtitle">A NEW LIGHT FOR THE GROWTOPIA FRONTIER</div>
            <div id="platform-buttons">
                <button id="start_button" class="shine-btn" onclick="playStart(document, element)">
                    <span class="label">START GAME</span>
                </button>
                <div class="shine-btn" onclick="OnEvent(event, 'on-options')">
                    <span class="label">SETTINGS</span>
                </div>
                <div class="shine-btn" onclick="OnEvent(event, 'on-about')">
                    <span class="label">ABOUT</span>
                </div>
                <div id="quit_button" class="shine-btn" onclick="OnEvent(event, 'on-quit')">
                    <span class="label">QUIT</span>
                </div>
            </div>
        </div>

        <div id="account-strip" data-visible="AppContext.IsLoggedIn">
            <div class="account-icon icon-img account-icon-firefly" />
            <span class="account-name">{{AppContext.GetPlayerName}}</span>
        </div>
        <div id="logout_button" onclick="OnEvent(event, 'on-logout')" data-visible="AppContext.IsLoggedIn">
            <span class="label" data-style-display="AppContext.IsUseUbiconnect?'block':'none'" data-rml="AppContext.GetAccountType == 'ubiconnect' ? 'LINK' : 'UNLINK'"></span>
            <span class="label" data-style-display="!AppContext.IsUseUbiconnect?'block':'none'">LOGOUT</span>
        </div>
        <div id="version-text"><span>{{AppContext.GetVersionString}}</span></div>
        <div id="footer-text">2026 Firefly: New Dawn.</div>

        <div id="launch-overlay">
            <div id="launch-bg"></div>
            <div id="launch-title">FIREFLY: NEW DAWN</div>
        </div>
    </body>
</rml>
