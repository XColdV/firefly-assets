<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="snip" fileName="game/doll.rttex" textureSize="155,124"/>
		<Sprite name="p_effect" fileName="game/dollf.rttex" textureSize="64,64" frame="0,0"/>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Jump"/>
					<State name="Fall"/>
					<State name="Punch"/>
				</States>
				<Transitions>
					<!-- Leave Punch (and any other state) once PUNCH is released -->
					<Transition to="Idle" from="Fall|Move|Jump|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<!-- Enter Punch from any movement state when PUNCH is pressed -->
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

<Animations>
			<!-- Mempercepat siklus idle dan memperbanyak frame diam agar kedipan natural -->
			<SpriteAnimation name="snip_idle" playOnState="Motion.Idle" sprite="snip" animTime="2000" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>0,0</Frame>
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
			</SpriteAnimation>
			
			<!-- Mengurangi waktu jadi 400ms dan membuat siklus langkah kaki sempurna (Kanan - Tengah - Kiri - Tengah) -->
			<SpriteAnimation name="snip_walk" playOnState="Motion.Move" sprite="snip" animTime="400" isLoop="true">
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>0,1</Frame>
				<Frame>3,0</Frame>
			</SpriteAnimation>
			
			<!-- Animasi lompat dibuat lebih cepat reaksinya -->
			<SpriteAnimation name="snip_jump" playOnState="Motion.Jump" sprite="snip" animTime="400" isLoop="false">
				<Frame>1,1</Frame>
			</SpriteAnimation>
			
			<!-- Mempercepat transisi frame saat jatuh/melayang -->
			<SpriteAnimation name="snip_fall" playOnState="Motion.Fall" sprite="snip" animTime="400" isLoop="false">
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
			
			<!-- Punch dipercepat menjadi 300ms agar serangan terasa lebih snappy -->
			<SpriteAnimation name="snip_punch" playOnState="Motion.Punch" sprite="snip" animTime="300" isLoop="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
			</SpriteAnimation>
		</Animations>
		<ParticleSystems>
			<ParticleSystem name="puncheffect">
				<Emitter>
					<Set name="offset">0,-22</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true">
					<Set name="sprite">p_effect</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.3</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="UserNameOffset">40</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<OnPunchStart>
			<ParticleSystemUpdate name="puncheffect"/>
		</OnPunchStart>

		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<RenderInFront>
			<SpriteRender name="snip" offset="0,0" alignment="DOWN_CENTER" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
		</RenderInFront>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="puncheffect"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
