<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="p_effect" fileName="game/firefly_particles_large.rttex" textureSize="64"/>
		<Sprite name="firefly" fileName="game/firefly_model.rttex" textureSize="64,64"/>

		<Animations>
			<SpriteAnimation name="firefly_idle" isLoop="true" playOnState="Motion.Idle" sprite="firefly" animTime="1800">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="firefly_walk" isLoop="true" playOnState="Motion.Move" sprite="firefly" animTime="1000">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>6,0</Frame>
				<Frame>7,0</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="firefly_jump" sprite="firefly" playOnState="Motion.Jump" animTime="500">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="firefly_fall" sprite="firefly" playOnState="Motion.Fall" animTime="500">
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
				<Frame>6,3</Frame>
			</SpriteAnimation>

			<SpriteAnimation name="firefly_punch" autoPlay="true" isLoop="true" playOnState="Action1.Punch" sprite="firefly" animTime="550">
				<Frame>0,4</Frame>
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
			</SpriteAnimation>
		</Animations>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Jump"/>
					<State name="Fall"/>
				</States>

				<Transitions>
					<Transition to="Idle" from="Fall|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>

					<Transition to="Move" from="Jump|Fall|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>

					<Transition to="Jump" from="Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>

					<Transition to="Fall" from="Jump|Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>

			<StateMachine name="Action1">
				<States>
					<State name="Idle"/>
					<State name="Punch"/>
				</States>

				<Transitions>
					<Transition from="Punch" to="Idle">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>

					<Transition from="Idle" to="Punch">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="UserNameOffset">40</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>

		<!-- KILL DEFAULT AVATAR -->

		<RenderHair>
			<StopIf>true</StopIf>
		</RenderHair>

		<RenderBody>
			<StopIf>true</StopIf>
		</RenderBody>

		<RenderShirt>
			<StopIf>true</StopIf>
		</RenderShirt>

		<RenderPants>
			<StopIf>true</StopIf>
		</RenderPants>

		<RenderFeet>
			<StopIf>true</StopIf>
		</RenderFeet>

		<RenderHand>
			<StopIf>true</StopIf>
		</RenderHand>

		<RenderFace>
			<StopIf>true</StopIf>
		</RenderFace>

		<!-- DRAW FIREFLY -->

		<RenderInFront>
			<SpriteRender
				name="firefly"
				alignment="DOWN_CENTER"
				offset="0,-8"/>

			<StopIf>
				<IsAction>PUNCH</IsAction>
			</StopIf>

			<SpriteRender
				name="firefly"
				alignment="DOWN_CENTER"
				offset="0,-8"
				onState="Action1.Punch"/>
		</RenderInFront>

	</RenderRules>
</ItemRenderer>