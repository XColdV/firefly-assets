<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="p_effect" fileName="game/firefly_particles_large.rttex" textureSize="64"/>
		<Sprite name="firefly" fileName="game/firefly_model.rttex" textureSize="64,64"/>
		<Sprite name="punch_firefly" fileName="game/firefly_model.rttex" textureSize="64,64" frame="0,4"/>
		<Animations>
			<SpriteAnimation name="firefly_idle" isLoop="true" playOnState="Motion.Idle" sprite="firefly" animTime="1200">
				<Frame>0,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="firefly_walk" isLoop="true" playOnState="Motion.Move" sprite="firefly" animTime="600">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>7,0</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="firefly_jump" isLoop="false" sprite="firefly" playOnState="Motion.Jump" animTime="300">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="firefly_fall" isLoop="false" sprite="firefly" playOnState="Motion.Fall" animTime="400">
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="firefly_punch" autoPlay="true" isLoop="true" playOnState="Action1.Punch" sprite="punch_firefly" animTime="600">
				<Frame>1,4</Frame>
				<Frame>2,4</Frame>
				<Frame>3,4</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="punch_continue" sprite="p_effect" animTime="200" isLoop="true" playOnAction="PUNCH">
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
		</Animations>
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|fall">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action1">
				<States>
					<State name="Idle"/>
					<State name="Punch"/>
					<State name="ZombiePunch"/>
				</States>
				<Transitions>
					<Transition from="ZombiePunch|Punch" to="Idle" >
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="ZombiePunch|Idle" to="Punch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Idle|Punch" to="ZombiePunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		<RenderOptions>
			<Default>
				<Set name="UserNameOffset">40</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="PunchSoundOverride">SHIRT</Set>
				<Set name="HideAvatar">true</Set>
			</Default>
		</RenderOptions>
		<ParticleSystems>
			<ParticleSystem name="punch_continue_particle">
				<Emitter attachment="targetPos">
					<Set name="offset">0, 0</Set>
					<Set name="lifeTime">0</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="delayTimer">0.24</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">p_effect</Set>
					<Set name="offset">0, 0</Set>
					<Set name="inSpecificOrder">true</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">12,16</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
	</Data>
	<RenderRules>
		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<ParticleSystemUpdate name="punch_continue_particle" onAction="PUNCH"/>
		</OnPunchUpdate>
		<Update>
			<ParticleSystemUpdate name="punch_continue_particle" onAction="PUNCH" />
		</Update>
		<OnPunchBegin>
			<ParticleSystemOff name="punch_continue_particle"/>
		</OnPunchBegin>
		<OnPunchStop>
			<ParticleSystemOff name="punch_continue_particle"/>
		</OnPunchStop>
		<RenderInFront>
			<ParticleSystemRender name="punch_continue_particle" onAction="PUNCH"/>
			
			<SpriteRender name="punch_firefly" offset="0,0" alignment="DOWN_CENTER" onState="Action1.Punch"/>
			
			<StopIf type="and">
				<IsAction>PUNCH</IsAction>
			</StopIf>
			
			<SpriteRender name="firefly" offset="0,0" alignment="DOWN_CENTER"/>
		</RenderInFront>
		<OnRespawned>
			<ParticleSystemUpdate name="effect_sp"/>
		</OnRespawned>
		<OnDamagedTile>
			<ParticleSystemUpdate name="punch_continue_particle" />
		</OnDamagedTile>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="punch_continue_particle"/>
		</OnDestroyedTile>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="effect_sp"/>
			<ParticleSystemOff name="punch_continue_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>