<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<!-- 64x64 sheet. Ruan Mei model with instrument attacks and flower particles. -->
		<Sprite name="s_body" fileName="game/ruanmei_model.rttex" textureSize="64" frame="0,0"/>
		<Sprite name="s_instrument" fileName="game/firefly_particle.rttex" textureSize="64" frame="4,2"/>
		<Sprite name="s_flower" fileName="game/ruanmei_model.rttex" textureSize="64" frame="0,4"/>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Animations>
			<!-- Idle: row 0, col 0 - elegant standing pose -->
			<SpriteAnimation name="a_Idle" playOnState="Motion.Idle" sprite="s_body" animTime="800" isLoop="true">
				<Frame>0,0</Frame>
			</SpriteAnimation>
			
			<!-- Walk/Run: row 1, cols 0-5 - graceful running animation -->
			<SpriteAnimation name="a_Move" playOnState="Motion.Move" sprite="s_body" animTime="600" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
			</SpriteAnimation>
			
			<!-- Jump: row 2, col 0 -->
			<SpriteAnimation name="a_Jump" playOnState="Motion.Jump" sprite="s_body" animTime="300" isLoop="true">
				<Frame>0,2</Frame>
			</SpriteAnimation>
			
			<!-- Fall: row 2, col 1 -->
			<SpriteAnimation name="a_Fall" playOnState="Motion.Fall" sprite="s_body" animTime="300" isLoop="true">
				<Frame>1,2</Frame>
			</SpriteAnimation>
			
			<!-- Attack: row 3, cols 0-4 - playing instrument animation -->
			<SpriteAnimation name="a_Punch" playOnState="Motion.Punch" sprite="s_body" animTime="350" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
			</SpriteAnimation>

			<!-- Gentle floating animation for idle elegance -->
			<SpriteSinPulseAnimation name="a_float" sprite="s_body" autoPlay="true">
				<Parameter name="pos.y">
					<Set name="period">3500</Set>
					<Set name="scale">2</Set>
				</Parameter>
			</SpriteSinPulseAnimation>
		</Animations>

		<ParticleSystems>
			<!-- Musical note/instrument particle thrown toward target -->
			<ParticleSystem name="instrument_particle">
				<Emitter>
					<Set name="offset">0,-24</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="useCharacterPos">true</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_instrument</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.45</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.7,0.7</KeyFrame>
						<KeyFrame>0.5, 1.2,1.2</KeyFrame>
						<KeyFrame>1, 1.5,1.5</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.75, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>

			<!-- Ambient flower particles floating around Ruan Mei -->
			<ParticleSystem name="flower_ambient">
				<Emitter>
					<Random name="offset" min="-25, -20" max="25, -35"/>
					<Random name="emissionInterval" min="0.3" max="0.5"/>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="useCharacterPos">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_flower</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="relativeToEmitter">false</Set>
					<Set name="initalRGB">1, 0.95, 1</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="initialAlpha">0.8</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.4, 0.4</Set>
					<Set name="finalScale">0.8, 0.8</Set>
					<Random name="lifeTime" min="2.5" max="3.5"/>
					<Random name="initialVelocity" min="-8, -25" max="8, -35"/>
					<Random name="initialAngle" min="0" max="360"/>
					<Random name="initialRotationRate" min="-90" max="90"/>
				</Particle>
			</ParticleSystem>

			<!-- Flower petals that scatter during movement -->
			<ParticleSystem name="flower_trail">
				<Emitter usePlayerFacing="true">
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Random name="emissionInterval" min="0.08" max="0.12"/>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="offset" min="-15, -10" max="15, -25"/>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_flower</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="lifeTime" min="1.2" max="1.8"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.9</KeyFrame>
						<KeyFrame>0.6, 0.7</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.5, 0.5</Set>
					<Set name="finalScale">0.3, 0.3</Set>
					<Set name="initalRGB">1, 0.9, 0.95</Set>
					<Random name="initialVelocity" min="-5, 8" max="5, 15"/>
					<Random name="initialAngle" min="0" max="360"/>
					<Random name="initialRotationRate" min="-180" max="180"/>
				</Particle>
			</ParticleSystem>

			<!-- Flower burst on attack -->
			<ParticleSystem name="flower_burst">
				<Emitter>
					<Set name="offset">0,-24</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">5</Set>
					<Set name="particlesToEmit">5</Set>
					<Set name="useCharacterPos">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_flower</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Random name="lifeTime" min="1.0" max="1.5"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="interpolateScale">true</Set>
					<Random name="initialScale" min="0.6,0.6" max="0.8,0.8"/>
					<Set name="finalScale">0.3, 0.3</Set>
					<Set name="initalRGB">1, 0.95, 1</Set>
					<Random name="initialVelocity" min="-40, -40" max="40, -60"/>
					<Set name="acceleration">0, 80</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Random name="initialRotationRate" min="-360" max="360"/>
				</Particle>
			</ParticleSystem>

			<!-- Elegant glow aura around Ruan Mei -->
			<ParticleSystem name="elegant_aura">
				<Emitter>
					<Set name="offset">0,-28</Set>
					<Set name="emissionInterval">2</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_flower</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="isBackgroundParticle">true</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="initalRGB">0.9, 0.85, 1</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">1.5, 1.5</Set>
					<Set name="finalScale">2.0, 2.0</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.2</KeyFrame>
						<KeyFrame>0.5, 0.35</KeyFrame>
						<KeyFrame>1, 0.1</KeyFrame>
					</Curve>
					<Set name="lifeTime">4</Set>
					<Set name="initialVelocity">0, 0</Set>
					<Set name="initialAngle">0</Set>
					<Set name="initialRotationRate">20</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<TileStampData>
			<Set name="FileName">game/firefly_particle.rttex</Set>
			<Set name="StartFrame">4,2</Set>
			<Set name="EndFrame">6,2</Set>
			<Set name="FrameCount">3</Set>
		</TileStampData>

		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderInFront>
			<SpriteRender name="s_body" offset="0,0" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderInFront>

		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">HAPPY</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<OnPunchStart>
			<ParticleSystemUpdate name="instrument_particle"/>
			<ParticleSystemUpdate name="flower_burst"/>
		</OnPunchStart>

		<AddClothingParticles>
			<ParticleSystemUpdate name="flower_ambient" drawShadow="false"/>
			<ParticleSystemUpdate name="elegant_aura" drawShadow="false"/>
			<ParticleSystemUpdate name="flower_trail" onAction="WALK|JUMP|FALL|JUMPDOUBLE" drawShadow="false"/>
		</AddClothingParticles>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="instrument_particle"/>
			<ParticleSystemOff name="flower_ambient"/>
			<ParticleSystemOff name="flower_trail"/>
			<ParticleSystemOff name="flower_burst"/>
			<ParticleSystemOff name="elegant_aura"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>

