<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<Sprite name="scythe" fileName="game/firefly_particles_large.rttex" textureSize="64" frame="3,2"/>
		<Sprite name="punch_effect" fileName="game/particles11.rttex" textureSize="32" frame="9,14"/>
		<Sprite name="ances" fileName="game/particles.rttex" textureSize="32" frame="13,12"/>
		<Sprite name="hitspark_sprite" fileName="game/particles.rttex" textureSize="32"/>
		<Sprite name="trail_sprite" fileName="game/particles.rttex" textureSize="32" frame="4,0"/>
		
		<SpriteAnimation name="sword_slash_frames" autoPlay="false" sprite="punch_effect">
			<Frame>10,14</Frame>
			<Frame>9,14</Frame>
		</SpriteAnimation>

		<SpriteAnimation name="HitSpark_Anim" autoPlay="false" isLoop="false" sprite="hitspark_sprite"  animTime="200">
			<Frame>7,5</Frame>
			<Frame>8,5</Frame>
			<Frame>9,5</Frame>
		</SpriteAnimation>

		<SpriteAnimation name="trail_anim" autoPlay="true" sprite="trail_sprite" animTime="1200">
			<Frame>3, 0</Frame>
			<Frame>4, 0</Frame>
		</SpriteAnimation>

		<ParticleSystems>
			<ParticleSystem name="puncheffect">
				<Emitter>
					<Set name="offset">0,-22</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true">
					<Set name="sprite">punch_effect</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Curve name="initialScale">
						<KeyFrame>1.5, 1.5, 1.5</KeyFrame>
						<KeyFrame>3, 3, 3</KeyFrame>
					</Curve>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="extra_left">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="emissionInterval">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="9, 0" max="16, 0"/>
					<Set name="sprite">ances</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="initalRGB">0.7, 0, 0.7</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.25, 0.25</Set>
					<Set name="finalScale">0.25, 0.25</Set>
					<Random name="initialVelocity" min="-20,-42" max="20,-30"/>
					<Set name="initialAngle">0</Set>
					<Random name="finalAngle" min="91" max="340"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="extra_right">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="emissionInterval">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="-16, 0" max="-9, 0"/>
					<Set name="sprite">ances</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="initalRGB">0.7, 0, 0.7</Set>
					<Set name="lifeTime">1</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.25, 0.25</Set>
					<Set name="finalScale">0.25, 0.25</Set>
					<Random name="initialVelocity" min="-20,-42" max="20,-30"/>
					<Set name="initialAngle">0</Set>
					<Random name="finalAngle" min="91" max="340"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ances_left">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="9, 0" max="16, 0"/>
					<Set name="sprite">ances</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="initalRGB">0.7, 0, 0.7</Set>
					<Set name="lifeTime">0.75</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.45, 0.20</Set>
					<Set name="finalScale">0, 0.55</Set>
					<Random name="initialVelocity" min="0,-16" max="0,-14"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ances_right">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="-16, 0" max="-9, 0"/>
					<Set name="sprite">ances</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="initalRGB">0.7, 0, 0.7</Set>
					<Set name="lifeTime">0.75</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.45, 0.20</Set>
					<Set name="finalScale">0, 0.55</Set>
					<Random name="initialVelocity" min="0,-16" max="0,-14"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="ps_hitspark" secondary="trail_hitspark">
                <Emitter>
					<Set name="particlesPerEmission">8</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">hitspark_sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">2,2</Set>
					<Random name="finalScale" min="0.1, 0.1" max="0.4, 0.4"/>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200"/>
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300"/>
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3"/>
				</Particle>
            </ParticleSystem>
			<ParticleSystem name="trail_hitspark">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">80</Set>
					<Set name="emissionInterval">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">trail_sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.2</Set>
					<Set name="initalRGB">0.7, 0, 0.7</Set>
					<Set name="initialRotationRate">150</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 0</KeyFrame>
						<KeyFrame>0.4, 1, 1</KeyFrame>
						<KeyFrame>0.8, 0.3, 0.3</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.8, 0</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialVelocity">0,0</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		<TileStampData>
			<Set name="FileName">game/particles9.rttex</Set>
			<Set name="EndFrame">7,27</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
		<RenderOptions>
			<Default>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
			</Default>
		</RenderOptions>
	</Data>
	<RenderRules>
		<RenderBackHandItem>
			<SpriteRender name="scythe" offset="15, 7" rotationPoint="0,1" flip="0,1" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA"/>
		</RenderBackHandItem>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face" onAction="PUNCH">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onAction="IDLE|FALL|WALK|JUMP">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">190</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle" onAction="PUNCH">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">0</Set>
			</AvatarTransform>
		</Update>
		<OnPunchStart>
			<ParticleSystemUpdate name="puncheffect"/>
		</OnPunchStart>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_hitspark"/>
		</OnDestroyedTile>
		<AddClothingParticles>
			<ParticleSystemUpdate name="ances_left" onAction="IDLE|FALL|WALK|PUNCH|JUMP"/>
			<ParticleSystemUpdate name="ances_right" onAction="IDLE|FALL|WALK|PUNCH|JUMP"/>
			<ParticleSystemUpdate name="extra_left" onAction="IDLE|FALL|WALK|PUNCH|JUMP"/>
			<ParticleSystemUpdate name="extra_right" onAction="IDLE|FALL|WALK|PUNCH|JUMP"/>
		</AddClothingParticles>
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="puncheffect"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>