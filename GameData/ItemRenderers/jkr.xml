<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer item="ITEM_ID_BUSTER_BRUSH">
  <Data>
    <StateMachines>
      <StateMachine name="playerState">
        <States>
          <State name="Equip"/>
          <State name="Fall"/>
          <State name="Punch"/>
        </States>
        <Transitions>
          <Transition from="Equip" to="Fall" >
            <Condition>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Fall" to="Equip">
            <Condition>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Equip|Fall" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Equip">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction operatorType="NotEqual">FALL</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch" to="Fall">
            <Condition type="and">
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsAction>FALL</IsAction>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine><StateMachine name="trailParticleState">
        <States>
          <State name="Equip"/>
          <State name="HorizontalMove"/>
          <State name="Punch"/>
          <State name="Sleep"/>
        </States>
        <Transitions>
          <Transition from="Equip|HorizontalMove|Punch" to="Sleep" >
            <Condition>
              <IsSleepingOnaBed>true</IsSleepingOnaBed>
            </Condition>
          </Transition>
          <Transition from="Equip|HorizontalMove|Sleep" to="Punch" >
            <Condition>
              <IsAction>PUNCH</IsAction>
            </Condition>
          </Transition>
          <Transition from="Punch|HorizontalMove|Sleep" to="Equip">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Less" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition from="Punch|Equip|Sleep" to="HorizontalMove">
            <Condition type="and">
              <IsSleepingOnaBed>false</IsSleepingOnaBed>
              <IsAction operatorType="NotEqual">PUNCH</IsAction>
              <IsVariableFloat name="speed.x" operator="Greater" abs="true">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Sprite name="equip_sprite" fileName="game/jkr.rttex" textureSize="80, 64" frame="0,0"/>
    <Sprite name="slash_sprite" fileName="game/particles_large10.rttex" textureSize="64" frame="0,4"/>
    <Sprite name="s_mist" fileName="game/jkr.rttex" textureSize="80, 64" frame="2,0"/>
    <Sprite name="haha" fileName="game/jkr.rttex" textureSize="80, 64" frame="1,0"/>
    <Sprite name="block_hit_sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="14,7"/>
    <Sprite name="punch_projectile_sprite" fileName="game/particles_large13.rttex" textureSize="64" frame="13,7"/>

    <Animations>
      <SpriteAnimation name="trail_drops_animation" sprite="trail_drops_sprite" animTime="500" isLoop="true">
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
        <Frame>4,1</Frame>
        <Frame>5,1</Frame>
        <Frame>6,1</Frame>
        <Frame>7,1</Frame>
        <Frame>8,1</Frame>
        <Frame>9,1</Frame>
        <Frame>10,1</Frame>
        <Frame>11,1</Frame>
        <Frame>12,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="slash_animation" sprite="slash_sprite" animTime="175" isLoop="true" playOnState="playerState.Punch">
        <Frame>0,4</Frame>
        <Frame>1,4</Frame>
        <Frame>2,4</Frame>
        <Frame>3,4</Frame>
        <Frame>4,4</Frame>
        <Frame>5,4</Frame>
        <Frame>6,4</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_mist" sprite="s_mist" animTime="300">
				<Frame>3,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
    </Animations>

    <RenderOptions>
      <Default>
        <Set name="DefaultRenderMannequinHandItem">false</Set>
        <Set name="HideParticlesOnTransform">false</Set>
        <Set name="IgnoreDefaultDamagedTileEffect">true</Set>
        <Set name="RenderBackArmBuild">false</Set>
        <Set name="RenderFrontArmInfected">true</Set>
        <Set name="RenderBackArmInfected">true</Set>
      </Default>
    </RenderOptions>
    <ParticleSystems>
      <ParticleSystem name="MistParticles" updateStage="AddClothingParticles" updateState="trailParticleState.HorizontalMove">
				<Emitter>
					<Set name="offset">-16, -8</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
					<Set name="emissionInterval">0.05</Set>
				</Emitter>
				<Particle usePlayerFacing="true" randomSpriteFrame="true">
					<Set name="sprite">s_mist</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
          <Random name="offset" min="-4, -16" max="-4, 0" />
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.6</Set>
					<Set name="initialVelocity">-50, 0</Set>
				</Particle>
			</ParticleSystem>
      
			<ParticleSystem name="punch_projectile" updateStage="OnPunchStart">
				<Emitter>
					<Set name="offset">32,-16</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">punch_projectile_sprite</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="lifeTime">0.4</Set>
          <Set name="initialScale">1.5, 1.5</Set>
          <Set name="initialAlpha">1, 0.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="tile_break_particle" updateStage="OnDestroyedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">haha</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0.1, 0.1</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="25,60"/>
					<Set name="gravityVector">20, 0</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="tile_hit_particle" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">block_hit_sprite</Set>
					<Random name="offset" min="-4, -4" max="4, 4"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.6, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.4, 0.4</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.8</Set>
				</Particle>
			</ParticleSystem>
			<ParticleSystem name="tile_hit_splash" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">haha</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="useGravity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.5, 0.5</KeyFrame>
						<KeyFrame>1, 0.1, 0.1</KeyFrame>
					</Curve>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="0,180" radiusRange="-45,45"/>
					<Set name="gravityVector">20, 0</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems></Data>

  <RenderRules>
    <RenderHandItem>
      <SpriteRender name="equip_sprite" offset="19,40" alignment="DOWN_CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA"/>
    </RenderHandItem>
    <RenderInFront>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <SpriteRender name="slash_sprite" offset="12,-16" scale="1.25,1.25" alignment="CENTER" rotateOffset="true"  blend="PREMULTIPLIED_ALPHA" onState="playerState.Punch" drawShadow="false" tintOverride="255,255,255,255"/>
    </RenderInFront>
    <AddClothingParticles>
      <StopIf type="or">
        <IsZombified>true</IsZombified>
        <IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_REBEL_RAIDER</IsWearing>
        <IsWearing slot="SHOES">ITEM_ID_STAR_FIGHTER_IMPERIAL_ENFORCER</IsWearing>
      </StopIf>
    </AddClothingParticles>
    <OnPunchStart>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
    </OnPunchStart>
    <OnPunchUpdate>
      <StopIf>
        <IsZombified>true</IsZombified>
      </StopIf>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
      <AvatarTransform class="ArmAngle" onState="playerState.Punch">
        <Set name="armName">arm2Angle</Set>
        <Set name="armAngle">1200</Set>
        <Set name="isAdditive">true</Set>
        <Set name="pointTowardsPunchTarget">false</Set>
      </AvatarTransform>
    </OnPunchUpdate>
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="punch_projectile"/>
      <ParticleSystemOff name="drop_particles"/>
      <ParticleSystemOff name="tile_break_particle"/>
      <ParticleSystemOff name="tile_hit_particle"/>
      <ParticleSystemOff name="tile_hit_splash"/>
    </SwitchOffClothingParticles>
  </RenderRules>
</ItemRenderer>