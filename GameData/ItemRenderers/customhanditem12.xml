<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
    <Data>
        <StateMachines>
            <StateMachine name="ActiveType">
                <States>
                    <State name="Normal" />
                    <State name="Build" />
                    <State name="Break" />
                </States>
                <Transitions>
                    <Transition to="Build" from="Normal|Break">
                        <Condition type="and">
                            <CompareCustomVariable VariableNameToCompare="BuildMode">true</CompareCustomVariable>
                        </Condition>
                    </Transition>					
                    <Transition to="Break" from="Normal|Build">
                        <Condition type="and">
                            <CompareCustomVariable VariableNameToCompare="BreakMode">true</CompareCustomVariable>
                        </Condition>
                    </Transition>			
                    <Transition to="Normal" from="Build|Break">
                        <Condition type="and">
                            <CompareCustomVariable VariableNameToCompare="BuildMode">false</CompareCustomVariable>
                            <CompareCustomVariable VariableNameToCompare="BreakMode">false</CompareCustomVariable>
                        </Condition>
                    </Transition>
                </Transitions>
            </StateMachine>
        </StateMachines>

        <Sprite name="NormalSprite" fileName="game/firefly_longhand.rttex" textureSize="64,32" frame="1, 5"/>
        <Sprite name="BuildSprite" fileName="game/firefly_longhand.rttex" textureSize="64,32" frame="1, 5"/>
        <Sprite name="BreakSprite" fileName="game/firefly_longhand.rttex" textureSize="64,32" frame="1, 5"/>
        <Sprite name="PunchSprite" fileName="game/particles11.rttex" textureSize="32" frame="12, 4"/>
        <Sprite name="HitSpark_Sprite" fileName="game/particles11.rttex" textureSize="32"/>
        <Sprite name="Smoke" fileName="game/particles.rttex" textureSize="32" frame="8, 1"/>
        <Sprite name="NormaldGear" fileName="game/firefly_particle.rttex" textureSize="32" frame="5, 2"/>
        <Sprite name="BuildGear" fileName="game/firefly_particle.rttex" textureSize="32" frame="5, 1"/>
        <Sprite name="BreakGear" fileName="game/firefly_particle.rttex" textureSize="32" frame="6, 1"/>

        <Animations>
			<SpriteAnimation name="HitSpark_Anim" autoPlay="false" isLoop="false" sprite="HitSpark_Sprite"  animTime="200">
				<Frame>30, 18</Frame>
				<Frame>30, 19</Frame>
			</SpriteAnimation>
            <SpriteCurveAnimation name="NormaldGear_rotation_anim" autoPlay="true" isLoop="true" sprite="NormaldGear" animTime="5000">
				<Curve name="rotation">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 360</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
            <SpriteCurveAnimation name="BuildGear_rotation_anim" autoPlay="true" isLoop="true" sprite="BuildGear" animTime="5000">
				<Curve name="rotation">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 360</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
            <SpriteCurveAnimation name="BreakGear_rotation_anim" autoPlay="true" isLoop="true" sprite="BreakGear" animTime="5000">
				<Curve name="rotation">
					<KeyFrame>0, 0</KeyFrame>
					<KeyFrame>1, 360</KeyFrame>
				</Curve>
			</SpriteCurveAnimation>
        </Animations>

        <ParticleSystems>
            <ParticleSystem name="hitSpark_particle" secondary="trail_particle" updateStage="OnDestroyedTile" updateState="ActiveType.Break">
				<Emitter>
					<Set name="particlesPerEmission">8</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">HitSpark_Sprite</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">2,2</Set>
					<Random name="finalScale" min="0.1, 0.1" max="0.4, 0.4"/>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200"/>
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300"/>
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3"/>
				</Particle>
			</ParticleSystem>
            
			<ParticleSystem name="trail_particle">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">80</Set>
					<Set name="emissionInterval">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">Smoke</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.2</Set>
					<Set name="initialRotationRate">150</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 0</KeyFrame>
						<KeyFrame>0.4, 1, 1</KeyFrame>
						<KeyFrame>0.8, 0.3, 0.3</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.8, 0</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialVelocity">0,0</Set>
				</Particle>
			</ParticleSystem>

            <ParticleSystem name="build_sparkles" updateStage="OnDamagedTile" updateState="ActiveType.Build">
                <Emitter>
                    <Set name="particlesPerEmission">5</Set>
                    <Set name="lifeTime">1.5</Set>
                    <Set name="useTargetTilePos">true</Set>
                </Emitter>
                <Particle>
                    <Set name="sprite">BuildGear</Set>
                    <Set name="blendingMode">ADDITIVE</Set>
                    <Set name="lifeTime">0.8</Set>
                    <Set name="initialScale">0.3,0.3</Set>
                    <Set name="finalScale">0.1,0.1</Set>
                    <Set name="interpolateScale">true</Set>
                    <RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="30,80"/>
                    <Random name="initialRotationRate" min="180" max="360"/>
                    <Set name="tintOverride">0,255,100,255</Set>
                    <Curve name="initialAlpha">
                        <KeyFrame>0, 1</KeyFrame>
                        <KeyFrame>0.7, 0.6</KeyFrame>
                        <KeyFrame>1, 0</KeyFrame>
                    </Curve>
                </Particle>
            </ParticleSystem>

            <ParticleSystem name="NormalOrbit">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.8</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<OrbitOffset>
						<Set name="maxScale">1</Set>
						<Set name="hasOrbit">true</Set>
						<Set name="hOrbitPeriod">6000</Set>
						<Set name="hAmplitude">20</Set>
						<Set name="hTimeOffset">0</Set>
						<Set name="vAmplitude">12</Set>
						<Set name="vOrbitPeriod">4000</Set>
						<Set name="vTimeOffset">0</Set>
						<Set name="minScale">0.5</Set>
					</OrbitOffset>
				</Emitter>
				<Particle>
					<Set name="sprite">NormaldGear</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.9</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="BuildOrbit">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.8</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<OrbitOffset>
						<Set name="maxScale">1</Set>
						<Set name="hasOrbit">true</Set>
						<Set name="hOrbitPeriod">-6000</Set>
						<Set name="hAmplitude">20</Set>
						<Set name="hTimeOffset">500</Set>
						<Set name="vAmplitude">12</Set>
						<Set name="vOrbitPeriod">4000</Set>
						<Set name="vTimeOffset">1500</Set>
						<Set name="minScale">0.5</Set>
					</OrbitOffset>
				</Emitter>
				<Particle>
					<Set name="sprite">BuildGear</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.9</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="BreakOrbit">
				<Emitter>
					<Set name="offset">0, -16</Set>
					<Set name="emissionInterval">0.6</Set>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
					<OrbitOffset>
						<Set name="maxScale">1</Set>
						<Set name="hasOrbit">true</Set>
						<Set name="hOrbitPeriod">-6000</Set>
						<Set name="hAmplitude">20</Set>
						<Set name="hTimeOffset">3000</Set>
						<Set name="vAmplitude">6</Set>
						<Set name="vOrbitPeriod">6000</Set>
						<Set name="vTimeOffset">0</Set>
						<Set name="minScale">0.5</Set>
					</OrbitOffset>
				</Emitter>
				<Particle>
					<Set name="sprite">BreakGear</Set>
					<Set name="relativeToEmitter">true</Set>
					<Set name="inSpecificOrder">false</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.7</Set>
				</Particle>
			</ParticleSystem>
        </ParticleSystems>

        <VariableMap>
            <Set name="BuildMode" UIOrder="1" RadioGroup="0" UIName="Build Mode">false</Set>
            <Set name="BreakMode" UIOrder="2" RadioGroup="0" UIName="Break Mode">false</Set>
            <Set name="GearXY">20, 0, 0</Set>
        </VariableMap>

        <RenderOptions>
            <Default>
                <Set name="DefaultRenderMannequinHandItem">false</Set>
                <Set name="HideParticlesOnTransform">false</Set>
                <Set name="PunchSoundOverride">HAND</Set>
                <Set name="PlayDefaultPunchAudio">false</Set>
                <Set name="IgnoreDefaultDamagedTileEffect">false</Set>
                <Set name="RenderFrontArmInfected">true</Set>
                <Set name="RenderBackArmInfected">true</Set>
            </Default>
        </RenderOptions>
    </Data>

    <RenderRules>
        <Update>
            <StopIf>
                <IsZombified>true</IsZombified>
            </StopIf>
            <AvatarTransform class="ArmAngle" onAction="PUNCH">
                <Set name="armName">arm2Angle</Set>
                <Set name="armAngle">270</Set>
            </AvatarTransform>
        </Update>

        <RenderInFront>
            <ParticleSystemRender name="NormalOrbit"/>
            <ParticleSystemRender name="BuildOrbit"/>
            <ParticleSystemRender name="BreakOrbit"/>
        </RenderInFront>

        <RenderHandItem value="1.23, 7.3">
            <Group>
                <Translate>GearXY</Translate>
                <SpriteRender name="NormaldGear" drawShadow="false" blend="PREMULTIPLIED_ALPHA" onState="ActiveType.Normal"/>
                <SpriteRender name="BuildGear" drawShadow="false" blend="PREMULTIPLIED_ALPHA" onState="ActiveType.Build"/>
                <SpriteRender name="BreakGear" drawShadow="false" blend="PREMULTIPLIED_ALPHA" onState="ActiveType.Break"/>
            </Group>

            <SpriteRender name="NormalSprite" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="ActiveType.Normal"/>
            <SpriteRender name="BuildSprite" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="ActiveType.Build"/>
            <SpriteRender name="BreakSprite" alignment="CENTER" rotateOffset="true" blend="PREMULTIPLIED_ALPHA" onState="ActiveType.Break"/>
            
            <SpriteRender name="PunchSprite" flip="1,0" offset="0, -20" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" blend="ADDITIVE" stretchToTarget="true" onAction="PUNCH" tintOverride="100,100,100,255" onState="ActiveType.Normal"/>
            <SpriteRender name="PunchSprite" flip="1,0" offset="0, -20" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" blend="ADDITIVE" stretchToTarget="true" onAction="PUNCH" tintOverride="0,255,0,255" onState="ActiveType.Build"/>
            <SpriteRender name="PunchSprite" flip="1,0" offset="0, -20" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" drawShadow="false" blend="ADDITIVE" stretchToTarget="true" onAction="PUNCH" tintOverride="255,0,0,255" onState="ActiveType.Break"/>
        </RenderHandItem>

        <AddClothingParticles>
            <Group onState="ActiveType.Normal">
                <ParticleSystemUpdate name="BuildOrbit"/>
                <ParticleSystemUpdate name="BreakOrbit"/>
            </Group>
            <Group onState="ActiveType.Build">
                <ParticleSystemUpdate name="NormalOrbit"/>
                <ParticleSystemUpdate name="BreakOrbit"/>
            </Group>
            <Group onState="ActiveType.Break">
                <ParticleSystemUpdate name="NormalOrbit"/>
                <ParticleSystemUpdate name="BuildOrbit"/>
            </Group>
        </AddClothingParticles>

        <OnPunchUpdate>
            <AvatarTransform class="Face">
                <Set name="face">MAD</Set>
            </AvatarTransform>
        </OnPunchUpdate>
    </RenderRules>
</ItemRenderer>