<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <!-- phainon_wings.rttex, each tile 128x128. Row 0 = left wing, Row 1 = right wing (flipped). -->
    <Sprite name="s_wings_left" fileName="game/phainon_wings.rttex" textureSize="128" frame="0,0"/>
    <Sprite name="s_wings_right" fileName="game/phainon_wings.rttex" textureSize="128" frame="1,1"/>
    
    <!-- Particle sprites for effects -->
    <Sprite name="s_sparkle" fileName="game/enigma_particles_small2.rttex" textureSize="32" frame="7,6"/>
    <Sprite name="s_glow" fileName="game/enigma_particles3.rttex" textureSize="64" frame="13,2"/>

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Idle"/>
          <State name="Jump"/>
          <State name="Fall"/>
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Fall">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
      
      <StateMachine name="Facing">
        <States>
          <State name="Left"/>
          <State name="Right"/>
        </States>
        <Transitions>
          <Transition to="Left" from="Right">
            <Condition>
              <IsFacingLeft>true</IsFacingLeft>
            </Condition>
          </Transition>
          <Transition to="Right" from="Left">
            <Condition>
              <IsFacingLeft>false</IsFacingLeft>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <!-- Left wing (row 0) -->
      <SpriteAnimation name="a_equip_left" sprite="s_wings_left" playOnState="Action.Idle" isLoop="true" animTime="300">
        <Frame>0,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump_left" sprite="s_wings_left" animTime="400" playOnState="Action.Jump">
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall_left" sprite="s_wings_left" animTime="300" isLoop="true" playOnState="Action.Fall">
        <Frame>2,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>

      <!-- Right wing (row 1) -->
      <SpriteAnimation name="a_equip_right" sprite="s_wings_right" playOnState="Action.Idle" isLoop="true" animTime="300">
        <Frame>1,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump_right" sprite="s_wings_right" animTime="400" playOnState="Action.Jump">
        <Frame>2,1</Frame>
        <Frame>1,1</Frame>
        <Frame>3,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall_right" sprite="s_wings_right" animTime="300" isLoop="true" playOnState="Action.Fall">
        <Frame>2,1</Frame>
        <Frame>0,1</Frame>
        <Frame>1,1</Frame>
      </SpriteAnimation>
      
      <!-- Floating animation for the Growtopian -->
      <SpriteSinPulseAnimation name="a_float_motion" sprite="s_wings_left" autoPlay="true">
        <Parameter name="pos.y">
          <Set name="period">3000</Set>
          <Set name="scale">3</Set>
        </Parameter>
      </SpriteSinPulseAnimation>
      
      <!-- Glow pulse animation -->
      <SpriteAnimation name="a_glow_pulse" sprite="s_glow" animTime="1000" autoPlay="true" isLoop="true">
        <Frame>13,2</Frame>
      </SpriteAnimation>
    </Animations>

    <ParticleSystems>
      <!-- Ambient sparkle particles around wings -->
      <ParticleSystem name="ps_wing_sparkles">
        <Emitter>
          <Random name="offset" min="-20, -15" max="20, -25"/>
          <Random name="emissionInterval" min="0.15" max="0.25"/>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="useCharacterPos">true</Set>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_sparkle</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="relativeToEmitter">false</Set>
          <Set name="initalRGB">0.8, 0.9, 1</Set>
          <Set name="initialAlpha">1</Set>
          <Set name="finalAlpha">0</Set>
          <Set name="interpolateAlpha">true</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.5, 0.5</Set>
          <Set name="finalScale">1.2, 1.2</Set>
          <Random name="lifeTime" min="1.5" max="2.5"/>
          <Random name="initialVelocity" min="-5, -20" max="5, -30"/>
          <Random name="initialAngle" min="0" max="360"/>
          <Random name="initialRotationRate" min="-180" max="180"/>
        </Particle>
      </ParticleSystem>

      <!-- Energy trail when moving/jumping (left side) -->
      <ParticleSystem name="ps_trail_left">
        <Emitter usePlayerFacing="true">
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offsetFacing">true</Set>
          <Random name="offset" min="-18, -10" max="-12, -20"/>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_sparkle</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Random name="lifeTime" min="0.6" max="1.0"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.7, 0.8</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.8, 0.8</Set>
          <Set name="finalScale">0.3, 0.3</Set>
          <Set name="initalRGB">0.7, 0.85, 1</Set>
          <Random name="initialVelocity" min="0, 5" max="0, 10"/>
          <Random name="initialRotationRate" min="-360" max="360"/>
        </Particle>
      </ParticleSystem>

      <!-- Energy trail when moving/jumping (right side) -->
      <ParticleSystem name="ps_trail_right">
        <Emitter usePlayerFacing="true">
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="emissionInterval">0.05</Set>
          <Set name="particlesPerEmission">1</Set>
          <Set name="offsetFacing">true</Set>
          <Random name="offset" min="12, -10" max="18, -20"/>
        </Emitter>
        <Particle randomSpriteFrame="true">
          <Set name="sprite">s_sparkle</Set>
          <Set name="isBackgroundParticle">false</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Random name="lifeTime" min="0.6" max="1.0"/>
          <Curve name="initialAlpha">
            <KeyFrame>0, 1</KeyFrame>
            <KeyFrame>0.7, 0.8</KeyFrame>
            <KeyFrame>1, 0</KeyFrame>
          </Curve>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">0.8, 0.8</Set>
          <Set name="finalScale">0.3, 0.3</Set>
          <Set name="initalRGB">0.7, 0.85, 1</Set>
          <Random name="initialVelocity" min="0, 5" max="0, 10"/>
          <Random name="initialRotationRate" min="-360" max="360"/>
        </Particle>
      </ParticleSystem>

      <!-- Subtle glow aura -->
      <ParticleSystem name="ps_glow_aura">
        <Emitter>
          <Set name="offset">0, -20</Set>
          <Set name="emissionInterval">1</Set>
          <Set name="infParticles">true</Set>
          <Set name="infLifeTime">true</Set>
          <Set name="particlesPerEmission">1</Set>
        </Emitter>
        <Particle>
          <Set name="sprite">s_glow</Set>
          <Set name="blendingMode">ADDITIVE</Set>
          <Set name="isBackgroundParticle">true</Set>
          <Set name="relativeToEmitter">true</Set>
          <Set name="initalRGB">0.6, 0.8, 1</Set>
          <Set name="interpolateScale">true</Set>
          <Set name="initialScale">1.2, 1.2</Set>
          <Set name="finalScale">1.5, 1.5</Set>
          <Curve name="initialAlpha">
            <KeyFrame>0, 0.3</KeyFrame>
            <KeyFrame>0.5, 0.5</KeyFrame>
            <KeyFrame>1, 0.3</KeyFrame>
          </Curve>
          <Set name="lifeTime">3</Set>
          <Set name="initialVelocity">0, 0</Set>
          <Random name="initialAngle" min="0" max="360"/>
          <Set name="initialRotationRate">30</Set>
        </Particle>
      </ParticleSystem>
    </ParticleSystems>
  </Data>

  <RenderRules>
    <!-- 128x128 tiles. Left wing nudged right ~3px; right wing shifted left ~4px and up ~7px.
         NOTE: offset applies to the whole render (all frames). Per-frame offsets (e.g. frames 1/2/3 only) aren't possible here - that would need the sprite sheet itself realigned. -->
    <RenderBackpack>
      <!-- Glow aura behind wings -->
      <SpriteRender name="s_glow" offset="0, -20" blend="ADDITIVE"/>
      <!-- Wings with floating effect -->
	  <SpriteRender name="s_wings_left" offset="-4,-16" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA"/>
      <SpriteRender name="s_wings_right" offset="1,-28" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA" alignment="CENTER"/>
    </RenderBackpack>

    <!-- Add particle systems -->
    <AddClothingParticles>
      <ParticleSystemUpdate name="ps_wing_sparkles" drawShadow="false"/>
      <ParticleSystemUpdate name="ps_glow_aura" drawShadow="false"/>
      <ParticleSystemUpdate name="ps_trail_left" onAction="JUMP|FALL|WALK|JUMPDOUBLE" drawShadow="false"/>
      <ParticleSystemUpdate name="ps_trail_right" onAction="JUMP|FALL|WALK|JUMPDOUBLE" drawShadow="false"/>
    </AddClothingParticles>

    <!-- Turn off particles when needed -->
    <SwitchOffClothingParticles>
      <ParticleSystemOff name="ps_wing_sparkles"/>
      <ParticleSystemOff name="ps_glow_aura"/>
      <ParticleSystemOff name="ps_trail_left"/>
      <ParticleSystemOff name="ps_trail_right"/>
    </SwitchOffClothingParticles>

    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
  </RenderRules>
</ItemRenderer>