<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
  <Data>
    <!-- phainon_wings.rttex, each tile 128x128. Row 0 = left wing, Row 1 = right wing (flipped). -->
    <Sprite name="s_wings_left" fileName="game/phainon_wings.rttex" textureSize="128" frame="0,0" />
    <Sprite name="s_wings_right" fileName="game/phainon_wings.rttex" textureSize="128" frame="0,1" />

    <StateMachines>
      <StateMachine name="Action">
        <States>
          <State name="Idle" />
          <State name="Jump" />
          <State name="Fall" />
        </States>
        <Transitions>
          <Transition to="Idle" from="Fall|Jump">
            <Condition>
              <IsVariableBool name="onGround">true</IsVariableBool>
            </Condition>
          </Transition>
          <Transition to="Jump" from="Idle|Fall">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
            </Condition>
          </Transition>
          <Transition to="Fall" from="Jump|Idle">
            <Condition type="and">
              <IsVariableBool name="onGround">false</IsVariableBool>
              <IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
            </Condition>
          </Transition>
        </Transitions>
      </StateMachine>
    </StateMachines>

    <Animations>
      <!-- Left wing (row 0) -->
      <SpriteAnimation name="a_equip_left" sprite="s_wings_left" playOnState="Action.Idle" isLoop="true" animTime="300">
        <Frame>0,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump_left" sprite="s_wings_left" animTime="400" playOnState="Action.Jump">
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
        <Frame>3,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall_left" sprite="s_wings_left" animTime="300" isLoop="true" playOnState="Action.Fall">
        <Frame>2,0</Frame>
        <Frame>1,0</Frame>
        <Frame>2,0</Frame>
      </SpriteAnimation>

      <!-- Right wing (row 1) -->
      <SpriteAnimation name="a_equip_right" sprite="s_wings_right" playOnState="Action.Idle" isLoop="true" animTime="300">
        <Frame>0,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_jump_right" sprite="s_wings_right" animTime="400" playOnState="Action.Jump">
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
        <Frame>3,1</Frame>
        <Frame>2,1</Frame>
      </SpriteAnimation>
      <SpriteAnimation name="a_fall_right" sprite="s_wings_right" animTime="300" isLoop="true" playOnState="Action.Fall">
        <Frame>2,1</Frame>
        <Frame>1,1</Frame>
        <Frame>2,1</Frame>
      </SpriteAnimation>
    </Animations>
  </Data>

  <RenderRules>
    <!-- 128x128 tiles: offsets scaled up (~2x) from the 64px Occeans values so the bigger wings sit on the back and don't overlap at center -->
    <RenderBackpack>
      <SpriteRender name="s_wings_left" offset="-14,-26" alignmentLeft="LEFT_CENTER" alignmentRight="RIGHT_CENTER" blend="PREMULTIPLIED_ALPHA" />
      <SpriteRender name="s_wings_right" offset="14,-26" flip="1,0" alignmentLeft="RIGHT_CENTER" alignmentRight="LEFT_CENTER" blend="PREMULTIPLIED_ALPHA" />
    </RenderBackpack>

    <OnPunchUpdate>
      <AvatarTransform class="Face">
        <Set name="face">MAD</Set>
      </AvatarTransform>
    </OnPunchUpdate>
  </RenderRules>
</ItemRenderer>
