<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="playerState">
				<States>
					<State name="Idle"/>
					<State name="Punch"/>
					<State name="ZombiePunch"/>
				</States>
				<Transitions>
					<Transition from="ZombiePunch|Punch" to="Idle">
						<Condition>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition from="ZombiePunch|Idle" to="Punch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>false</IsZombified>
						</Condition>
					</Transition>
					<Transition from="Idle|Punch" to="ZombiePunch">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
							<IsZombified>true</IsZombified>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<!-- Phainon Sword: 256x64 sprite -->
		<Sprite name="s_phainon_sword" fileName="game/phainon_sword.rttex" textureSize="256,64" frame="0,0"/>
		
		<!-- Particle sprites -->
		<Sprite name="s_sparkle" fileName="game/particles11.rttex" textureSize="32" frame="13,28"/>
		<Sprite name="s_energy" fileName="game/particles_large10.rttex" textureSize="64" frame="15,9"/>
		<Sprite name="s_slash" fileName="game/particles2.rttex" textureSize="32" frame="8,1"/>
		<Sprite name="s_impact" fileName="game/particles4.rttex" textureSize="32" frame="3,15"/>

		<Animations>
			<SpriteAnimation name="a_impact" autoPlay="false" sprite="s_impact">
				<Frame>3,15</Frame>
				<Frame>4,15</Frame>
				<Frame>5,15</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<!-- Celestial energy aura around sword -->
			<ParticleSystem name="ps_sword_aura">
				<Emitter attachment="handspotRoot">
					<Random name="offset" min="5,-15" max="25,-20"/>
					<Random name="emissionInterval" min="0.08" max="0.15"/>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">2</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_sparkle</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="inSpecificOrder">true</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.4" max="0.8"/>
					<Set name="lifeTime">1.2</Set>
					<Random name="initialVelocity" min="0,-35" max="0,-25"/>
					<Random name="initialAngle" min="0" max="360"/>
				</Particle>
			</ParticleSystem>

			<!-- Energy trail when moving -->
			<ParticleSystem name="ps_energy_trail">
				<Emitter usePlayerFacing="true">
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Random name="emissionInterval" min="0.06" max="0.1"/>
					<Set name="particlesPerEmission">1</Set>
					<Set name="offsetFacing">true</Set>
					<Random name="offset" min="10,-15" max="20,-20"/>
				</Emitter>
				<Particle>
					<Set name="sprite">s_energy</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Random name="lifeTime" min="0.8" max="1.2"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>0.6, 0.5</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="interpolateScale">true</Set>
					<Random name="initialScale" min="0.6,0.6" max="0.9,0.9"/>
					<Set name="finalScale">0.3,0.3</Set>
					<Set name="initalRGB">0.7, 0.85, 1</Set>
					<Random name="initialVelocity" min="0,5" max="0,12"/>
					<Random name="initialRotationRate" min="-180" max="180"/>
				</Particle>
			</ParticleSystem>

			<!-- Powerful slash projectile (odd punches) -->
			<ParticleSystem name="ps_slash_odd" updateStage="OnPunchStart">
				<Emitter onPunchCount="odd">
					<Set name="offset">0,-18</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_slash</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8,0.8</KeyFrame>
						<KeyFrame>1, 2.2,2.2</KeyFrame>
					</Curve>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>

			<!-- Powerful slash projectile (even punches) -->
			<ParticleSystem name="ps_slash_even" updateStage="OnPunchStart">
				<Emitter onPunchCount="even">
					<Set name="offset">0,-18</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_slash</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8,0.8</KeyFrame>
						<KeyFrame>1, 2.2,2.2</KeyFrame>
					</Curve>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>

			<!-- Impact particles on hit -->
			<ParticleSystem name="ps_hit_impact" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="offset">0,0</Set>
					<Set name="lifeTime">0</Set>
					<Random name="particlesPerEmission" min="8" max="12"/>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_impact</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="isBackgroundParticle">false</Set>
					<Set name="lifeTime">0.7</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="finalRotationRate">5</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">0</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">1.2,1.2</Set>
					<Random name="finalScale" min="0.3,0.3" max="0.8,0.8"/>
					<Set name="interpolateAngle">true</Set>
					<Random name="initialAngle" min="-360" max="360"/>
					<Random name="finalAngle" min="-360" max="360"/>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,90"/>
					<Random name="posOffset" min="0,0" max="16,16"/>
				</Particle>
			</ParticleSystem>

			<!-- Destruction burst -->
			<ParticleSystem name="ps_destroy_burst">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">20</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_sparkle</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">1.5</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1.5,1.5</KeyFrame>
						<KeyFrame>1, 0.2,0.2</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="20"/>
					<Random name="offset" min="0" max="16"/>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0,100</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="60,140"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<TileStampData>
			<Set name="FileName">game/particles9.rttex</Set>
			<Set name="EndFrame">19,22</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>

		<RenderOptions>
			<Default>
				<Set name="DefaultRenderMannequinHandItem">false</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="RenderFrontArmInfected">true</Set>
				<Set name="RenderBackArmInfected">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderHandItem>
			<SpriteRender name="s_phainon_sword" rotateOffset="true" offset="19,8" scale="0.35,0.35" blend="PREMULTIPLIED_ALPHA"/>
		</RenderHandItem>

		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm1Angle</Set>
				<Set name="armAngle">1200</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1000</Set>
				<Set name="isAdditive">true</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_hit_impact"/>
		</OnDamagedTile>

		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_destroy_burst"/>
		</OnDestroyedTile>

		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_sword_aura" drawShadow="false"/>
			<ParticleSystemUpdate name="ps_energy_trail" onAction="JUMP|WALK|FALL|JUMPDOUBLE" drawShadow="false"/>
		</AddClothingParticles>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="ps_slash_odd"/>
			<ParticleSystemOff name="ps_slash_even"/>
			<ParticleSystemOff name="ps_hit_impact"/>
			<ParticleSystemOff name="ps_destroy_burst"/>
			<ParticleSystemOff name="ps_sword_aura"/>
			<ParticleSystemOff name="ps_energy_trail"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>

