<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<StateMachines>
			<StateMachine name="playerState">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Fall"/>
					<State name="Jump"/>
					<State name="DoubleJump"/>
					<State name="SpiritGuide"/>
				</States>
				<Transitions>
					<Transition from="SpiritGuide|Jump|Fall|Move|DoubleJump" to="Idle">
						<Condition>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Jump|Fall|Idle|DoubleJump" to="Move">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>WALK</IsAction>
						</Condition>
					</Transition>				
					<Transition from="Move|Jump|Fall|Idle|DoubleJump" to="SpiritGuide">
						<Condition type="and">
							<IsWearing slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0</IsVariableFloat>
							<IsAction operatorType="NotEqual">FALL</IsAction>
						</Condition>
					</Transition>
					<Transition from="SpiritGuide|Fall|Move|Idle" to="Jump">
						<Condition type="and">
							<IsWearing operatorType="NotEqual" slot="CHESTITEM">ITEM_ID_HAUNTED</IsWearing>
							<IsAction>JUMP</IsAction>
						</Condition>
					</Transition>
					<Transition from="Jump|Fall" to="DoubleJump">
						<Condition>
							<IsAction>JUMPDOUBLE</IsAction>
						</Condition>
					</Transition>
					<Transition from="DoubleJump|SpiritGuide|Jump|Idle|Move" to="Fall">
						<Condition type="and">
							<IsVariableFloat name="speed.y" operator="Greater" abs="false">0.01</IsVariableFloat>
							<IsAction>FALL</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Facing">
				<States>
					<State name="Left"/>
					<State name="Right"/>
				</States>
				<Transitions>
					<Transition to="Left" from="Right">
						<Condition>
							<IsFacingLeft>true</IsFacingLeft>
						</Condition>
					</Transition>
					<Transition to="Right" from="Left">
						<Condition>
							<IsFacingLeft>false</IsFacingLeft>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<!-- Phainon Sword: 256x64 sprite, scaled to 0.35 for better visibility -->
		<Sprite name="s_phainon_sword" fileName="game/phainon_sword.rttex" textureSize="256,64" frame="0,0"/>
		
		<!-- Particle sprites from particles11.rttex (standard ItemRenderers) -->
		<Sprite name="s_sparkle" fileName="game/particles11.rttex" textureSize="32" frame="13,28"/>
		<Sprite name="s_mist" fileName="game/particles11.rttex" textureSize="32" frame="17,28"/>
		<Sprite name="s_slash" fileName="game/particles11.rttex" textureSize="32" frame="16,28"/>
		<Sprite name="s_glow" fileName="game/particles_large10.rttex" textureSize="64" frame="15,9"/>

		<Animations>
			<!-- Sparkle animation frames -->
			<SpriteAnimation name="a_sparkle" sprite="s_sparkle">
				<Frame>13,28</Frame>
				<Frame>14,28</Frame>
				<Frame>15,28</Frame>
			</SpriteAnimation>
		</Animations>
		
		<ParticleSystems>
			<!-- Mist emanating from sword -->
			<ParticleSystem name="ps_sword_mist">
				<Emitter>
					<Random name="offset" min="-10, -20" max="20, -30"/>
					<Random name="emissionInterval" min="0.3" max="0.6"/>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_mist</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">1.2</Set>
					<Set name="initialVelocity">0,-5</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.5, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.5" max="0.9"/>
				</Particle>
			</ParticleSystem>

			<!-- Sparkles around sword -->
			<ParticleSystem name="ps_sword_sparkles">
				<Emitter>
					<Random name="offset" min="-5, -15" max="20, -25"/>
					<Random name="emissionInterval" min="0.1" max="0.2"/>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_sparkle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Random name="lifeTime" min="0.8" max="1.2"/>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Random name="initialScale" min="0.4" max="0.8"/>
					<Random name="initialVelocity" min="0, -25" max="0, -35"/>
					<Random name="initialAngle" min="0" max="360"/>
				</Particle>
			</ParticleSystem>

			<!-- Slash projectile on punch -->
			<ParticleSystem name="ps_punch_slash">
				<Emitter>
					<Set name="offset">0,-15</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_slash</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateVelocity">true</Set>
					<Set name="initialScale">1.5,1.5</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>

			<!-- Impact sparkles when hitting tiles -->
			<ParticleSystem name="ps_hit_sparkles">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">12</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_sparkle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1,1</KeyFrame>
						<KeyFrame>1, 0.3,0.3</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15"/>
					<Random name="offset" min="0" max="16"/>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="45,315" radiusRange="40,100"/>
				</Particle>
			</ParticleSystem>

			<!-- Break burst when destroying tiles -->
			<ParticleSystem name="ps_break_burst">
				<Emitter>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">18</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">s_sparkle</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.2</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 1.2,1.2</KeyFrame>
						<KeyFrame>1, 0.2,0.2</KeyFrame>
					</Curve>
					<Random name="initialRotationRate" min="5" max="15"/>
					<Random name="offset" min="0" max="16"/>
					<Set name="useGravity">true</Set>
					<Set name="gravityVector">0, 100</Set>
					<RandomRadial name="initialVelocity" angleRange="0,360" radiusRange="50,120"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderHandItem>
			<!-- Main sword: 256x64 scaled to ~90x23 (0.35 scale) for better visibility -->
			<SpriteRender name="s_phainon_sword" rotateOffset="true" offset="10,-5" scale="0.35,0.35" blend="PREMULTIPLIED_ALPHA"/>
			
			<!-- Glow effect behind sword -->
			<SpriteRender name="s_slash" rotateOffset="true" offset="-3,-4" scale="1,1" blend="ADDITIVE" drawShadow="false"/>
		</RenderHandItem>

		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
			<AvatarTransform class="ArmAngle">
				<Set name="armName">arm2Angle</Set>
				<Set name="armAngle">1500</Set>
				<Set name="isAdditive">true</Set>
				<Set name="pointTowardsPunchTarget">false</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<OnPunchStart>
			<ParticleSystemUpdate name="ps_punch_slash"/>
		</OnPunchStart>

		<OnDamagedTile>
			<ParticleSystemUpdate name="ps_hit_sparkles"/>
		</OnDamagedTile>

		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_break_burst"/>
		</OnDestroyedTile>

		<AddClothingParticles>
			<ParticleSystemUpdate name="ps_sword_mist" drawShadow="false"/>
			<ParticleSystemUpdate name="ps_sword_sparkles" drawShadow="false"/>
		</AddClothingParticles>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="ps_punch_slash"/>
			<ParticleSystemOff name="ps_hit_sparkles"/>
			<ParticleSystemOff name="ps_break_burst"/>
			<ParticleSystemOff name="ps_sword_mist"/>
			<ParticleSystemOff name="ps_sword_sparkles"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>