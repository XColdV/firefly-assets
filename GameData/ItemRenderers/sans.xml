<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<!-- Sans body sprite (128x128) -->
		<Sprite name="s_sans_body" fileName="game/sans_undertale.rttex" textureSize="128,128" frame="0,0"/>
		
		<!-- Gaster Blaster sprites (128x80) -->
		<Sprite name="s_blaster" fileName="game/gaster_blaster.rttex" textureSize="128,80" frame="0,0"/>
		<Sprite name="s_blaster_fire" fileName="game/gaster_blaster.rttex" textureSize="128,80" frame="0,3"/>
		<Sprite name="s_blaster_particle" fileName="game/gaster_blaster.rttex" textureSize="128,80" frame="3,2"/>
		
		<!-- TileStamp -->
		<Sprite name="s_tileHit" fileName="game/firefly_particle.rttex" textureSize="64" frame="7,2"/>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Animations>
			<!-- Sans body idle: row 0, cols 0-2 -->
			<SpriteAnimation name="a_sans_idle" sprite="s_sans_body" animTime="900" isLoop="true" playOnState="Motion.Idle">
				<Frame>0,0</Frame>
			</SpriteAnimation>
			
			<!-- Sans body walk: row 1, cols 0-3 -->
			<SpriteAnimation name="a_sans_walk" sprite="s_sans_body" animTime="600" isLoop="true" playOnState="Motion.Move">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
			
			<!-- Sans body jump: row 2, col 0 -->
			<SpriteAnimation name="a_sans_jump" sprite="s_sans_body" animTime="200" isLoop="true" playOnState="Motion.Jump">
				<Frame>0,2</Frame>
			</SpriteAnimation>
			
			<!-- Sans body fall: row 2, col 1 -->
			<SpriteAnimation name="a_sans_fall" sprite="s_sans_body" animTime="200" isLoop="true" playOnState="Motion.Fall">
				<Frame>1,2</Frame>
			</SpriteAnimation>
			
			<!-- Sans body attack: row 3, cols 1,0 (summon blaster) -->
			<SpriteAnimation name="a_sans_attack" sprite="s_sans_body" animTime="400" isLoop="true" playOnState="Motion.Punch">
				<Frame>0,3</Frame>
			</SpriteAnimation>
			
			<!-- Gaster Blaster idle: row 0, cols 0-2 (plays when NOT punching) -->
			<SpriteAnimation name="a_blaster_idle" sprite="s_blaster" animTime="700" isLoop="true" playOnState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
			</SpriteAnimation>
			
			<!-- Gaster Blaster attack: row 1 cols 0-2 (charging), then row 2 col 0 (fire) -->
			<SpriteAnimation name="a_blaster_attack" sprite="s_blaster" animTime="600" isLoop="true" playOnState="Motion.Punch">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>0,2</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<!-- Blaster charging particles -->
			<ParticleSystem name="ps_blaster_charge" updateStage="RenderPet" updateState="Motion.Punch">
				<Emitter>
					<Random name="emissionInterval" min="0.05" max="0.08"/>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.5</Set>
					<Set name="particlesPerEmission">2</Set>
					<Set name="offset">-48,-10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_blaster_particle</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.5</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.15,0.15</KeyFrame>
						<KeyFrame>1, 0.25,0.25</KeyFrame>
					</Curve>
					<Random name="offset" min="-8,-8" max="8,8"/>
					<Random name="initialVelocity" min="-20,-20" max="20,-30"/>
					<Random name="initialAngle" min="0" max="360"/>
					<Random name="initialRotationRate" min="-180" max="180"/>
				</Particle>
			</ParticleSystem>
			
			<!-- Blaster fire beam -->
			<ParticleSystem name="ps_blaster_fire" updateStage="RenderPet" updateState="Motion.Punch">
				<Emitter usePlayerFacing="true">
					<Random name="emissionInterval" min="0.002" max="0.004"/>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="particlesPerEmission">3</Set>
					<Set name="offset">-40,-10</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_blaster_fire</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.15</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 1</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.2,0.15</KeyFrame>
						<KeyFrame>1, 0.25,0.18</KeyFrame>
					</Curve>
					<Random name="targetPosOffset" min="-3,-13" max="3,13"/>
					<VectorTo name="initialVelocity" source="targetPos" offset="targetPosOffset" duration="lifeTime" x="1"/>
					<Set name="rotateWithVelocity">true</Set>
				</Particle>
			</ParticleSystem>
			
			<!-- TileStamp particles -->
			<ParticleSystem name="ps_tileHit" updateStage="OnDamagedTile">
				<Emitter>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_tileHit</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="lifeTime">0.3</Set>
					<Random name="initialAngle" min="0" max="360"/>
					<Set name="initialRotationRate">360</Set>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<TileStampData>
			<Set name="FileName">game/firefly_particle.rttex</Set>
			<Set name="StartFrame">7,2</Set>
			<Set name="EndFrame">9,2</Set>
			<Set name="FrameCount">3</Set>
		</TileStampData>

		<RenderOptions>
			<Default>
				<Set name="NeedRenderPet">true</Set>
				<Set name="PetOffsetDuplication">0,0</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">false</Set>
				<Set name="HideParticlesOnTransform">false</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="IncludeAllActions">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<!-- Sans body rendered as character overlay (like Castorice) -->
		<RenderInFront>
			<SpriteRender name="s_sans_body" offset="0,0" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA" scale="0.35,0.35"/>
		</RenderInFront>

		<!-- Gaster Blaster rendered as pet (like Pollux Dragon) -->
		<RenderPet>
			<SpriteRender name="s_blaster" alignment="DOWN_CENTER" offset="-48,0" scale="0.25,0.25" blend="PREMULTIPLIED_ALPHA"/>
		</RenderPet>

		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="ps_blaster_charge"/>
			<ParticleSystemOff name="ps_blaster_fire"/>
			<ParticleSystemOff name="ps_tileHit"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>

