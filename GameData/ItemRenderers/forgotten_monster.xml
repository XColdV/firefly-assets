<ItemRenderer>
	<Data>
		<!--  1 RESOURCE TUNGGAL - GRID PER CELL 571x573  -->
		<Sprite name="md_sprite" fileName="game/the_forgotten_monster.rttex" textureSize="571,573"/>
		
		<!-- REGISTER SPRITE PARTIKEL (SIZE FIXED 32x32) -->
		<Sprite name="s_eff_awet" fileName="game/particles2.rttex" textureSize="32,32" frame="28,50"/>
		<Sprite name="s_eff_rame" fileName="game/particles2.rttex" textureSize="32,32" frame="5,11"/>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Jump"/>
					<State name="Fall"/>
					<State name="Punch"/>
					<State name="Respawn"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsVariableBool name="isAttacking">false</IsVariableBool>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition type="and">
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Animations>
			<!--  1. IDLE ANIMATION (7 FRAMES)  -->
			<SpriteAnimation name="gigi_Idle_Animation" playOnState="Motion.Idle" sprite="md_sprite" animTime="800" isLoop="true">
				<Frame>0,0</Frame>
				<Frame>1,0</Frame>
				<Frame>2,0</Frame>
				<Frame>3,0</Frame>
				<Frame>4,0</Frame>
				<Frame>5,0</Frame>
				<Frame>0,1</Frame>
			</SpriteAnimation>
			<!--  2. WALK ANIMATION (7 FRAMES)  -->
			<SpriteAnimation name="gigi_Walk_Animation" playOnState="Motion.Move" sprite="md_sprite" animTime="600" isLoop="true">
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
				<Frame>4,1</Frame>
				<Frame>5,1</Frame>
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<!--  3. PUNCH ANIMATION (10 FRAMES)  -->
			<SpriteAnimation name="gigi_Punch_Animation" playOnState="Motion.Punch" sprite="md_sprite" animTime="400" isLoop="false">
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
				<Frame>4,3</Frame>
				<Frame>5,3</Frame>
			</SpriteAnimation>
			<!--  4. JUMP ANIMATION (1 FRAME)  -->
			<SpriteAnimation name="gigi_Jump_Animation" playOnState="Motion.Jump" sprite="md_sprite" animTime="600">
				<Frame>2,4</Frame>
			</SpriteAnimation>
			<!--  5. FALL ANIMATION (1 FRAME)  -->
			<SpriteAnimation name="gigi_Fall_Animation" playOnState="Motion.Fall" sprite="md_sprite" animTime="600">
				<Frame>1,4</Frame>
			</SpriteAnimation>
		</Animations>

		<!-- ENGINE DUAL PARTIKEL DENGAN SISTEM HARD LOCK MAX PARTICLES -->
		<ParticleSystems>
			<!-- PARTIKEL 1 (6,5): LOCK 1 PARTIKEL (1 MATI BARU 1 SPAWN), LIFE TIME 2 DETIK -->
			<ParticleSystem name="ps_monster_awet" updateStage="AddClothingParticles" renderStage="RenderInFront">
				<!-- ANTI SPAM: Dikunci cuma boleh ada 1 partikel aktif di layar -->
				<Set name="maxParticles">1</Set>
				<Emitter>
					<Set name="emissionInterval">0.5</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_eff_awet</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<!-- Kunci 2 detik sesuai request -->
					<Set name="lifeTime">2.0</Set>
					
					<!-- Kunci Posisi di badan monster -->
					<Random name="offset" min="-150, -10150" max="150, -9950" />
					
					<Random name="initialVelocity" min="-10, -10" max="10, 10" />
					<Set name="initialScale">1.0,1.0</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.2, 0.8</KeyFrame>
						<KeyFrame>0.8, 0.8</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>

			<!-- PARTIKEL 2 (5,11): TETEP RAME BRUTAL LUAS (Yg ini gpp kata lu) -->
			<ParticleSystem name="ps_monster_rame" updateStage="AddClothingParticles" renderStage="RenderInFront">
				<Emitter>
					<Set name="emissionInterval">0.04</Set>
					<Set name="infParticles">true</Set>
					<Set name="particlesPerEmission">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_eff_rame</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.5</Set>
					
					<Random name="offset" min="-160, -10160" max="160, -9940" />
					
					<Random name="initialVelocity" min="-25, -25" max="25, 25" />
					<Set name="initialScale">1.0,1.0</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0</KeyFrame>
						<KeyFrame>0.15, 0.9</KeyFrame>
						<KeyFrame>0.8, 0.9</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="JumpEndStateRange">100</Set>
				<Set name="ClothingOffsetFromShoes">10000</Set>
				<Set name="IsRidingBird">true</Set>
				<Set name="IsVehicle">true</Set>
				<Set name="UserNameOffset">15</Set>
				<Set name="RenderShoesWithMermaidTail">true</Set>
				<Set name="ShoesHidesBodyLegs">true</Set>
				<Set name="IsToRenderPants">false</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderInFront>
			<StopIf>
				<IsVariableBool name="isMannequin">true</IsVariableBool>
				<IsRenderMod>RENDER_MOD_MINI_YOU</IsRenderMod>
			</StopIf>
			<!--  FIX UTAMA: KARENA SCALE 1,1 MAKA OFFSET WAJIB -10048 BUAT NARIK SPRITE KEMBALI KE TANAH  -->
			<SpriteRender name="md_sprite" offset="0,-9900" alignment="DOWN_CENTER" drawShadow="true" scale="0.7,0.7" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
		</RenderInFront>
		
		<RenderShoes>
			<StopIf>
				<IsSitting>true</IsSitting>
				<IsSleepingOnaBed>true</IsSleepingOnaBed>
				<IsWearing slot="SHIRT">ITEM_ID_TACTICAL_STEALTH_DEVICE</IsWearing>
			</StopIf>
		</RenderShoes>
		
		<OnPunchStart> </OnPunchStart>
	</RenderRules>
</ItemRenderer>
