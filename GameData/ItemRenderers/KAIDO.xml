<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="kaido" fileName="game/KAIDO.rttex" textureSize="150,150"/>
		<Sprite name="p_effect" fileName="game/pkaido.rttex" textureSize="124,96 frame="0,0"/>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Jump"/>
					<State name="Fall"/>
					<State name="Punch"/>
				</States>
				<Transitions>
					<!-- Leave Punch (and any other state) once PUNCH is released -->
					<Transition to="Idle" from="Fall|Move|Jump|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<!-- Enter Punch from any movement state when PUNCH is pressed -->
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Animations>
			<SpriteAnimation name="kaido_idle" playOnState="Motion.Idle" sprite="kaido" animTime="1200" isLoop="true">
				<Frame>0,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kaido_walk" playOnState="Motion.Move" sprite="kaido" animTime="600" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kaido_jump" playOnState="Motion.Jump" sprite="kaido" animTime="600" isLoop="false">
				<Frame>0,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="kaido_fall" playOnState="Motion.Fall" sprite="kaido" animTime="600" isLoop="false">
				<Frame>1,2</Frame>
			</SpriteAnimation>
			<!-- Punch loops while held; the Punch state is left when PUNCH is released -->
			<SpriteAnimation name="kaido_punch" playOnState="Motion.Punch" sprite="kaido" animTime="400" isLoop="false">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
				<Frame>2,3</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<ParticleSystem name="puncheffect">
				<Emitter usePlayerFacing="true">
					<Random name="emissionInterval" min="0.002" max="0.004"/>
					<Set name="infParticles">true</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="particlesPerEmission">3</Set>
					<Set name="offset">14,-67</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true">
					<Set name="sprite">p_effect</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="lifeTime">0.15</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialScale">
						<KeyFrame>0, 0.6, 0.6</KeyFrame>
						<KeyFrame>1, 0.05, 0.05</KeyFrame>
					</Curve>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="UserNameOffset">55</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
				<Set name="ShouldHover">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<OnPunchStart>
			<ParticleSystemUpdate name="puncheffect"/>
		</OnPunchStart>

		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<RenderInFront>
			<SpriteRender name="kaido" offset="0,0" alignment="DOWN_CENTER" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
		</RenderInFront>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="puncheffect"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
