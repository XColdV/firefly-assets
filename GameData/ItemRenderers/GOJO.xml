<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<!-- Pastikan fileName sesuai dengan nama file Anda (ganti .rttex jika perlu) -->
		<Sprite name="gojo_sprite" fileName="game/GOJO.rttex" textureSize="96,96"/>
		<Sprite name="p_effect" fileName="game/GOJO.rttex" textureSize="96,96" frame="0,4 1"/>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle"/>
					<State name="Move"/>
					<State name="Jump"/>
					<State name="Fall"/>
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Animations>
			<!-- Idle: 0,0 sampai 5,0 -->
			<SpriteAnimation name="gojo_idle" playOnState="Motion.Idle" sprite="gojo_sprite" animTime="6000" isLoop="true">
    <Frame>0,0</Frame>
    <Frame>0,0</Frame>
    <Frame>0,0</Frame>
    <Frame>0,0</Frame>
    
    <Frame>1,0</Frame>
    <Frame>2,0</Frame>
    <Frame>4,0</Frame>
    <Frame>3,0</Frame>
    <Frame>4,0</Frame>
    <Frame>2,0</Frame>
    <Frame>5,0</Frame>
    
    <Frame>0,0</Frame>
</SpriteAnimation>
			
			<!-- Walk: 0,1 sampai 3,1 -->
			<SpriteAnimation name="gojo_walk" playOnState="Motion.Move" sprite="gojo_sprite" animTime="600" isLoop="true">
				<Frame>0,1</Frame>
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
				<Frame>3,1</Frame>
			</SpriteAnimation>
			
			<!-- Jump: 0,2 sampai 4,2 -->
			<SpriteAnimation name="gojo_jump" playOnState="Motion.Jump" sprite="gojo_sprite" animTime="600" isLoop="false">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
			</SpriteAnimation>
			
			<!-- Fall: 5,2 sampai 6,2 -->
			<SpriteAnimation name="gojo_fall" playOnState="Motion.Fall" sprite="gojo_sprite" animTime="600" isLoop="false">
				<Frame>4,2</Frame>
				<Frame>5,2</Frame>
			</SpriteAnimation>
			
			<!-- Punch: 0,3 sampai 1,3 -->
			<SpriteAnimation name="gojo_punch" playOnState="Motion.Punch" sprite="gojo_sprite" animTime="400" isLoop="true">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<!-- Efek dari Attack di koordinat 0,4 -->
			<ParticleSystem name="puncheffect">
				<Emitter>
					<Set name="offset">0,-22</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true">
					<Set name="sprite">p_effect</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 1, 1</KeyFrame>
						<KeyFrame>1, 1, 1</KeyFrame>
					</Curve>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="UserNameOffset">40</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<OnPunchStart>
			<ParticleSystemUpdate name="puncheffect"/>
		</OnPunchStart>

		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<RenderInFront>
			<SpriteRender name="gojo_sprite" offset="0,0" alignment="DOWN_CENTER" onState="Motion.Idle|Motion.Move|Motion.Jump|Motion.Fall|Motion.Punch"/>
		</RenderInFront>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="puncheffect"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>