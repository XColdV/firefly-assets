<?xml version="1.0"?>
<ItemRenderer>
	<Data>
		<Sprite name="p_effect" fileName="game/march7th_model.rttex" textureSize="64,96"/>
		<Sprite name="march7th" fileName="game/march7th_model.rttex" textureSize="64,96"/>
		<Sprite name="march7th_fall_sprite" fileName="game/march7th_fall.rttex" textureSize="96,96"/>
		<Sprite name="march7th_punch_sprite" fileName="game/march7th_punch.rttex" textureSize="128,128"/>
		
		<Animations>
			<SpriteAnimation name="march7th_idle" isLoop="true" playOnState="Motion.Idle" sprite="march7th" animTime="1200">
				<Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame><Frame>4,0</Frame><Frame>5,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="march7th_walk" isLoop="true" playOnState="Motion.Move" sprite="march7th" animTime="600">
				<Frame>0,1</Frame><Frame>1,1</Frame><Frame>2,1</Frame><Frame>3,1</Frame><Frame>4,1</Frame><Frame>5,1</Frame><Frame>6,1</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="march7th_jump" sprite="march7th" playOnState="Motion.Jump">
				<Frame>0,2</Frame><Frame>1,2</Frame><Frame>2,2</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="march7th_fall" sprite="march7th_fall_sprite" playOnState="Motion.Fall">
				<Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="march7th_punch" autoPlay="true" isLoop="true" playOnState="Action1.Punch" sprite="march7th_punch_sprite" animTime="600">
				<Frame>0,0</Frame><Frame>1,0</Frame><Frame>2,0</Frame><Frame>3,0</Frame>
			</SpriteAnimation>
			
			<SpriteAnimation name="bow_slash_frames" autoPlay="false" sprite="p_effect">
				<Frame>0,3</Frame>
				<Frame>1,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="HitSpark_Anim" autoPlay="false" isLoop="false" sprite="p_effect" animTime="200">
				<Frame>2,3</Frame>
				<Frame>3,3</Frame>
			</SpriteAnimation>
			<SpriteAnimation name="trail_anim" autoPlay="true" sprite="p_effect" animTime="1200">
				<Frame>4,3</Frame>
			</SpriteAnimation>
		</Animations>
		
		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move">
						<Condition type="and"><IsVariableBool name="onGround">true</IsVariableBool><IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat></Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle">
						<Condition type="and"><IsVariableBool name="onGround">true</IsVariableBool><IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat></Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move">
						<Condition type="and"><IsVariableBool name="onGround">false</IsVariableBool><IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat></Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move">
						<Condition type="and"><IsVariableBool name="onGround">false</IsVariableBool><IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat></Condition>
					</Transition>
				</Transitions>
			</StateMachine>
			<StateMachine name="Action1">
				<States><State name="Idle"/><State name="Punch"/><State name="ZombiePunch"/></States>
				<Transitions>
					<Transition from="ZombiePunch|Punch" to="Idle"><Condition><IsAction operatorType="NotEqual">PUNCH</IsAction></Condition></Transition>
					<Transition from="ZombiePunch|Idle" to="Punch"><Condition type="and"><IsAction>PUNCH</IsAction><IsZombified>false</IsZombified></Condition></Transition>
					<Transition from="Idle|Punch" to="ZombiePunch"><Condition type="and"><IsAction>PUNCH</IsAction><IsZombified>true</IsZombified></Condition></Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>
		
		<RenderOptions>
			<Default>
				<Set name="UserNameOffset">40</Set>
				<Set name="IgnoreDefaultDamagedTileEffect">true</Set>
				<Set name="IgnoreDefaultDestroyedTileEffect">true</Set>
				<Set name="HasDeathParticles">true</Set>
				<Set name="IgnorePunchTypeCheck">true</Set>
				<Set name="HideAvatarOnDeath">true</Set>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">false</Set>
				<Set name="PunchSoundOverride">HAND</Set>
				<Set name="RenderBackArmBuild">false</Set>
				<Set name="HideAvatar">true</Set>
			</Default>
		</RenderOptions>

		<ParticleSystems>
			<ParticleSystem name="puncheffect">
				<Emitter>
					<Set name="offset">16,-20</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="lifeTime">0.25</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle alternateSpriteFrameWithPunch="true">
					<Set name="sprite">p_effect</Set>
					<Set name="spriteFrame">0,3</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Set name="interpolateAlpha">false</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Curve name="initialScale">
						<KeyFrame>1.5, 1.5, 1.5</KeyFrame>
						<KeyFrame>2, 2, 2</KeyFrame>
					</Curve>
					<Set name="interpolateVelocity">true</Set>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
					<VectorTo name="finalVelocity" source="targetPos" duration="lifeTime" x="1" angle="0"/>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ps_hitspark" secondary="trail_hitspark">
				<Emitter>
					<Set name="particlesPerEmission">8</Set>
					<Set name="lifeTime">2</Set>
					<Set name="useTargetTileColorForTint">true</Set>
				</Emitter>
				<Particle randomSpriteFrame="true">
					<Set name="sprite">p_effect</Set>
					<Set name="spriteFrame">1,3</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="useGravity">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">2,2</Set>
					<Random name="finalScale" min="0.1, 0.1" max="0.4, 0.4"/>
					<Set name="lifeTime">1</Set>
					<RandomRadial name="initialVelocity" angleRange="30,330" radiusRange="80,200"/>
					<Set name="gravityVector">0, 100</Set>
					<Random name="initialRotationRate" min="-300" max="300"/>
					<Random name="posOffset" min="0.1, 0" max="16.1, 16.3"/>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="trail_hitspark">
				<Emitter>
					<Set name="lifeTime">1</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">80</Set>
					<Set name="emissionInterval">0.2</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">p_effect</Set>
					<Set name="spriteFrame">2,3</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">1.2</Set>
					<Set name="initalRGB">0.6, 0.8, 1.0</Set>
					<Set name="initialRotationRate">150</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0, 0</KeyFrame>
						<KeyFrame>0.4, 1, 1</KeyFrame>
						<KeyFrame>0.8, 0.3, 0.3</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 0.5</KeyFrame>
						<KeyFrame>0.8, 0</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<Set name="initialVelocity">0,0</Set>
				</Particle>
			</ParticleSystem>

			<ParticleSystem name="ice_aura_left">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="9, 0" max="16, 0"/>
					<Set name="sprite">p_effect</Set>
					<Set name="spriteFrame">3,3</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="initalRGB">0.6, 0.8, 1.0</Set>
					<Set name="lifeTime">0.75</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.45, 0.20</Set>
					<Set name="finalScale">0, 0.55</Set>
					<Random name="initialVelocity" min="0,-16" max="0,-14"/>
				</Particle>
			</ParticleSystem>
			
			<ParticleSystem name="ice_aura_right">
				<Emitter>
					<Set name="infParticles">true</Set>
					<Set name="infLifeTime">true</Set>
					<Set name="emissionInterval">0.25</Set>
					<Set name="particlesPerEmission">3</Set>
				</Emitter>
				<Particle>
					<Random name="offset" min="-16, 0" max="-9, 0"/>
					<Set name="sprite">p_effect</Set>
					<Set name="spriteFrame">3,3</Set>
					<Set name="blendingMode">ADDITIVE</Set>
					<Set name="initalRGB">0.6, 0.8, 1.0</Set>
					<Set name="lifeTime">0.75</Set>
					<Set name="initialAlpha">1</Set>
					<Set name="finalAlpha">1</Set>
					<Set name="interpolateAlpha">true</Set>
					<Set name="interpolateScale">true</Set>
					<Set name="initialScale">0.45, 0.20</Set>
					<Set name="finalScale">0, 0.55</Set>
					<Random name="initialVelocity" min="0,-16" max="0,-14"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>
		
		<TileStampData>
			<Set name="FileName">game/particles11.rttex</Set>
			<Set name="EndFrame">12,16</Set>
			<Set name="FrameCount">4</Set>
		</TileStampData>
	</Data>
	
	<RenderRules>
		<Update>
			<StopIf>
				<IsZombified>true</IsZombified>
			</StopIf>
			<AvatarTransform class="Face" onAction="PUNCH">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</Update>
		
		<OnPunchStart>
			<ParticleSystemUpdate name="puncheffect"/>
		</OnPunchStart>
		<OnDestroyedTile>
			<ParticleSystemUpdate name="ps_hitspark"/>
		</OnDestroyedTile>
		
		<AddClothingParticles>
			<ParticleSystemUpdate name="ice_aura_left" onAction="IDLE|FALL|WALK|PUNCH|JUMP"/>
			<ParticleSystemUpdate name="ice_aura_right" onAction="IDLE|FALL|WALK|PUNCH|JUMP"/>
		</AddClothingParticles>
		
		<RenderInFront>
			<SpriteRender name="march7th_punch_sprite" offset="-32,0" alignment="DOWN_CENTER" onState="Action1.Punch"/>
			<StopIf type="and">
				<IsAction>PUNCH</IsAction>
			</StopIf>
			
			<SpriteRender name="march7th_fall_sprite" offset="-16,0" alignment="DOWN_CENTER" onState="Motion.Fall"/>
			<StopIf type="and">
				<IsVariableBool name="onGround">false</IsVariableBool>
				<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
			</StopIf>
			
			<SpriteRender name="march7th" offset="0,0" alignment="DOWN_CENTER"/>
		</RenderInFront>
		
		<SwitchOffClothingParticles>
			<ParticleSystemOff name="puncheffect"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>