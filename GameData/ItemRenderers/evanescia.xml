<?xml version="1.0" encoding="utf-8"?>
<ItemRenderer>
	<Data>
		<!-- 64x64 sheet. Overlay character rendered in front of the avatar (shirt-style). -->
		<Sprite name="s_body" fileName="game/evanescia_model.rttex" textureSize="64" frame="0,0"/>
		<Sprite name="s_slash" fileName="game/evanescia_model.rttex" textureSize="64" frame="0,5"/>

		<StateMachines>
			<StateMachine name="Motion">
				<States>
					<State name="Idle" />
					<State name="Move" />
					<State name="Jump" />
					<State name="Fall" />
					<State name="Punch"/>
				</States>
				<Transitions>
					<Transition to="Idle" from="Fall|Move|Jump|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Less" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Move" from="Jump|Fall|Idle|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">true</IsVariableBool>
							<IsVariableFloat name="speed.length" operator="Greater" abs="true">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Jump" from="Idle|Move|Fall|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Less">-0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Fall" from="Jump|Idle|Move|Punch">
						<Condition type="and">
							<IsVariableBool name="onGround">false</IsVariableBool>
							<IsVariableFloat name="speed.y" operator="Greater">0.1</IsVariableFloat>
							<IsAction operatorType="NotEqual">PUNCH</IsAction>
						</Condition>
					</Transition>
					<Transition to="Punch" from="Idle|Move|Jump|Fall">
						<Condition>
							<IsAction>PUNCH</IsAction>
						</Condition>
					</Transition>
				</Transitions>
			</StateMachine>
		</StateMachines>

		<Animations>
			<!-- Idle: row 0, col 0 -->
			<SpriteAnimation name="a_Idle" playOnState="Motion.Idle" sprite="s_body" animTime="600" isLoop="true">
				<Frame>0,0</Frame>
			</SpriteAnimation>
			<!-- Walk/Run: row 2, cols 0-4 -->
			<SpriteAnimation name="a_Move" playOnState="Motion.Move" sprite="s_body" animTime="500" isLoop="true">
				<Frame>0,2</Frame>
				<Frame>1,2</Frame>
				<Frame>2,2</Frame>
				<Frame>3,2</Frame>
				<Frame>4,2</Frame>
			</SpriteAnimation>
			<!-- Jump: row 1, cols 1-2 -->
			<SpriteAnimation name="a_Jump" playOnState="Motion.Jump" sprite="s_body" animTime="300" isLoop="true">
				<Frame>1,1</Frame>
				<Frame>2,1</Frame>
			</SpriteAnimation>
			<!-- Fall: row 3, col 0 -->
			<SpriteAnimation name="a_Fall" playOnState="Motion.Fall" sprite="s_body" animTime="300" isLoop="true">
				<Frame>0,3</Frame>
			</SpriteAnimation>
			<!-- Attack: row 4, cols 3-4 -->
			<SpriteAnimation name="a_Punch" playOnState="Motion.Punch" sprite="s_body" animTime="250" isLoop="true">
				<Frame>3,4</Frame>
				<Frame>4,4</Frame>
			</SpriteAnimation>
		</Animations>

		<ParticleSystems>
			<!-- Slash effect (row 5, col 0) thrown toward the punch target -->
			<ParticleSystem name="slash_particle">
				<Emitter>
					<Set name="offset">0,-16</Set>
					<Set name="lifeTime">0</Set>
					<Set name="particlesPerEmission">1</Set>
					<Set name="particlesToEmit">1</Set>
				</Emitter>
				<Particle>
					<Set name="sprite">s_slash</Set>
					<Set name="blendingMode">PREMULTIPLIED_ALPHA</Set>
					<Set name="lifeTime">0.4</Set>
					<Set name="rotateWithVelocity">true</Set>
					<Curve name="initialScale">
						<KeyFrame>0, 0.8,0.8</KeyFrame>
						<KeyFrame>1, 1.5,1.5</KeyFrame>
					</Curve>
					<Curve name="initialAlpha">
						<KeyFrame>0, 1</KeyFrame>
						<KeyFrame>0.7, 1</KeyFrame>
						<KeyFrame>1, 0</KeyFrame>
					</Curve>
					<VectorTo name="initialVelocity" source="targetPos" duration="lifeTime" x="1"/>
				</Particle>
			</ParticleSystem>
		</ParticleSystems>

		<RenderOptions>
			<Default>
				<Set name="IncludeAllActions">true</Set>
				<Set name="PlayDefaultPunchAudio">true</Set>
			</Default>
		</RenderOptions>
	</Data>

	<RenderRules>
		<RenderInFront>
			<SpriteRender name="s_body" offset="0,0" alignment="DOWN_CENTER" blend="PREMULTIPLIED_ALPHA"/>
		</RenderInFront>

		<OnPunchUpdate>
			<AvatarTransform class="Face">
				<Set name="face">MAD</Set>
			</AvatarTransform>
		</OnPunchUpdate>

		<OnPunchStart>
			<ParticleSystemUpdate name="slash_particle"/>
		</OnPunchStart>

		<SwitchOffClothingParticles>
			<ParticleSystemOff name="slash_particle"/>
		</SwitchOffClothingParticles>
	</RenderRules>
</ItemRenderer>
